    }

    .mobile-image-slideshow {
      position: relative;
      isolation: isolate;
      width: 100%;
      overflow: hidden;
      touch-action: pan-y;
      user-select: none;
    }

    .mobile-image-track {
      display: flex;
      width: 100%;
      transition: transform 420ms cubic-bezier(.76, 0, .24, 1);
      will-change: transform;
    }

    .mobile-image-slide {
      flex: 0 0 100%;
      width: 100%;
    }

    .mobile-image-slide img {
      display: block;
      width: 100%;
      height: auto;
      pointer-events: none;
    }

    .mobile-slide-zone {
      position: absolute;
      top: 0;
      bottom: 0;
      z-index: 2;
      width: 50%;
      padding: 0;
      border: 0;
      background: transparent;
    }

    .mobile-slide-zone-prev {
