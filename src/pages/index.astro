---
import { sanityClient } from 'sanity:client'
import Layout from '../layouts/Layout.astro'

const imageWidths = [480, 768, 1024, 1440, 1920, 2400]

function sanityImage(url, width) {
  if (!url) return undefined

  const separator = url.includes('?') ? '&' : '?'
  return `${url}${separator}auto=format&fit=max&w=${width}&q=82`
}

function sanitySrcset(url) {
  if (!url) return undefined

  return imageWidths
    .map((width) => `${sanityImage(url, width)} ${width}w`)
    .join(', ')
}

const projects = await sanityClient.fetch(`
  *[_type == "project" && hidden != true] | order(orderRank asc, _createdAt asc) {
    _id,
    "slug": slug.current,
    headline,
    tags,
    media[] {
      _key,
      mediaType,
      width,
      alt,

      image {
        asset-> {
          url,
          metadata {
            dimensions {
              width,
              height,
              aspectRatio
            }
          }
        }
      },

      video {
        asset-> {
          url
        }
      },

      poster {
        asset-> {
          url,
          metadata {
            dimensions {
              width,
              height,
              aspectRatio
            }
          }
        }
      },

      slides[] {
        alt,
        asset-> {
          url,
          metadata {
            dimensions {
              width,
              height,
              aspectRatio
            }
          }
        }
      },

      galleryImages[] {
        alt,
        asset-> {
          url,
          originalFilename,
          metadata {
            dimensions {
              width,
              height,
              aspectRatio
            }
          }
        }
      }
    },

    brand,
    projectName,
    role,
    agency,
    description,
    enableReadMore,
    longDescription
  }
`)
---

<Layout>
  <main>
    {
      projects.map((project) => {
        const media = project.media ?? []

        const mobileImages = media.flatMap((item) => {
          if (item.mediaType === 'image' && item.image?.asset?.url) {
            return [
              {
                key: item._key,
                url: item.image.asset.url,
                alt: item.alt || '',
                width: item.image.asset.metadata?.dimensions?.width,
                height: item.image.asset.metadata?.dimensions?.height,
              },
            ]
          }

          if (item.mediaType === 'slideshow' && item.slides?.length) {
            return item.slides
              .filter((slide) => slide.asset?.url)
              .map((slide, index) => ({
                key: `${item._key}-${index}`,
                url: slide.asset.url,
                alt: slide.alt || '',
                width: slide.asset.metadata?.dimensions?.width,
                height: slide.asset.metadata?.dimensions?.height,
              }))
          }

          if (item.mediaType === 'gallery' && item.galleryImages?.length) {
            return item.galleryImages
              .filter((image) => image.asset?.url)
              .map((image, index) => ({
                key: `${item._key}-gallery-${index}`,
                url: image.asset.url,
                alt: image.alt || image.asset.originalFilename || '',
                width: image.asset.metadata?.dimensions?.width,
                height: image.asset.metadata?.dimensions?.height,
              }))
          }

          return []
        })

        const firstImageMediaIndex = media.findIndex(
          (item) =>
            (item.mediaType === 'image' && item.image?.asset?.url) ||
            (item.mediaType === 'slideshow' &&
              item.slides?.some((slide) => slide.asset?.url)) ||
            (item.mediaType === 'gallery' &&
              item.galleryImages?.some((image) => image.asset?.url))
        )

        return (
          <section
            class="project"
            data-project
            data-project-slug={project.slug}
            data-project-tags={(project.tags ?? []).join('|')}
            id={project.slug ? `project-${project.slug}` : undefined}
          >
            <h2>{project.headline}</h2>

            <div class="tags">
              {project.tags?.map((tag) => (
                <button
                  class="project-tag"
                  type="button"
                  data-project-tag
                  data-tag={tag}
                  aria-pressed="false"
                >
                  <span data-tag-label>{tag}</span>
                  <span class="tag-clear" aria-hidden="true"> ×</span>
                </button>
              ))}
            </div>

            <div class="media-grid desktop-media">
              {project.media?.map((item) => (
                <div
                  class:list={[
                    'media-item',
                    item.width === 'half' ? 'half' : 'full'
                  ]}
                >
                  {
                    item.mediaType === 'video' && item.video?.asset?.url ? (
                      <div class="custom-video-player" data-video-player>
                        <video
                          loop
                          playsinline
                          preload="none"
                          poster={sanityImage(item.poster?.asset?.url, 1600)}
                          data-video
                        >
                          <source data-src={item.video.asset.url} />
                        </video>

                        <button
                          class="video-play-large"
                          type="button"
                          data-video-play-large
                          aria-label="Play video"
                        >
                          <span aria-hidden="true"></span>
                        </button>

                        <div class="video-controls" data-video-controls>
                          <button
                            class="video-control-button"
                            type="button"
                            data-video-play
                            aria-label="Play video"
                          >
                            <span data-video-play-icon aria-hidden="true">▶</span>
                          </button>

                          <input
                            class="video-progress"
                            type="range"
                            min="0"
                            max="1000"
                            value="0"
                            step="1"
                            data-video-progress
                            aria-label="Video progress"
                          />

                          <span class="video-time" data-video-time>0:00</span>

                          <button
                            class="video-control-button"
                            type="button"
                            data-video-mute
                            aria-label="Mute video"
                          >
                            <span data-video-mute-icon aria-hidden="true">S</span>
                          </button>

                          <button
                            class="video-control-button"
                            type="button"
                            data-video-fullscreen
                            aria-label="Enter fullscreen"
                          >
                            <span aria-hidden="true">⛶</span>
                          </button>
                        </div>
                      </div>
                    ) : item.mediaType === 'gallery' && item.galleryImages?.length ? (
                      <div class="project-gallery">
                        {item.galleryImages.map((image) => (
                          image.asset?.url ? (
                            <img
                              src={sanityImage(image.asset.url, 1440)}
                              srcset={sanitySrcset(image.asset.url)}
                              sizes={item.width === 'half'
                                ? '(max-width: 700px) 100vw, 25vw'
                                : '(max-width: 700px) 100vw, 50vw'}
                              width={image.asset.metadata?.dimensions?.width}
                              height={image.asset.metadata?.dimensions?.height}
                              alt={image.alt || image.asset.originalFilename || ''}
                              decoding="async"
                            />
                          ) : null
                        ))}
                      </div>
                    ) : item.mediaType === 'slideshow' && item.slides?.length ? (
                      <div
                        class="project-slideshow"
                        data-project-slideshow
                      >
                        <div class="slideshow-viewport">
                          <div class="slideshow-track" data-slideshow-track>
                            {item.slides.map((slide) => (
                              <div class="slideshow-slide">
                                <img
                                  src={sanityImage(slide.asset?.url, 1920)}
                                  srcset={sanitySrcset(slide.asset?.url)}
                                  sizes={item.width === 'half'
                                    ? '(max-width: 700px) 100vw, 50vw'
                                    : '100vw'}
                                  width={slide.asset?.metadata?.dimensions?.width}
                                  height={slide.asset?.metadata?.dimensions?.height}
                                  alt={slide.alt || ''}
                                  decoding="async"
                                />
                              </div>
                            ))}
                          </div>
                        </div>

                        <button
                          class="slideshow-control slideshow-control-prev"
                          type="button"
                          data-slideshow-prev
                          aria-label="Previous slide"
                        >
                          <span aria-hidden="true">←</span>
                        </button>

                        <button
                          class="slideshow-control slideshow-control-next"
                          type="button"
                          data-slideshow-next
                          aria-label="Next slide"
                        >
                          <span aria-hidden="true">→</span>
                        </button>
                      </div>
                    ) : item.image?.asset?.url ? (
                      <img
                        src={sanityImage(item.image.asset.url, 1920)}
                        srcset={sanitySrcset(item.image.asset.url)}
                        sizes={item.width === 'half'
                          ? '(max-width: 700px) 100vw, 50vw'
                          : '100vw'}
                        width={item.image.asset.metadata?.dimensions?.width}
                        height={item.image.asset.metadata?.dimensions?.height}
                        alt={item.alt || ''}
                        decoding="async"
                      />
                    ) : null
                  }
                </div>
              ))}
            </div>


            <div class="mobile-media">
              {media.map((item, mediaIndex) => {
                if (item.mediaType === 'video' && item.video?.asset?.url) {
                  return (
                    <div class="mobile-media-item">
                      <div class="custom-video-player" data-video-player>
                          <video
                              loop
                            playsinline
                            preload="none"
                            poster={sanityImage(item.poster?.asset?.url, 1600)}
                            data-video
                          >
                            <source data-src={item.video.asset.url} />
                          </video>

                          <button
                            class="video-play-large"
                            type="button"
                            data-video-play-large
                            aria-label="Play video"
                          >
                            <span aria-hidden="true"></span>
                          </button>

                          <div class="video-controls" data-video-controls>
                            <button
                              class="video-control-button"
                              type="button"
                              data-video-play
                              aria-label="Play video"
                            >
                              <span data-video-play-icon aria-hidden="true">▶</span>
                            </button>

                            <input
                              class="video-progress"
                              type="range"
                              min="0"
                              max="1000"
                              value="0"
                              step="1"
                              data-video-progress
                              aria-label="Video progress"
                            />

                            <span class="video-time" data-video-time>0:00</span>

                            <button
                              class="video-control-button"
                              type="button"
                              data-video-mute
                              aria-label="Mute video"
                            >
                              <span data-video-mute-icon aria-hidden="true">S</span>
                            </button>

                            <button
                              class="video-control-button"
                              type="button"
                              data-video-fullscreen
                              aria-label="Enter fullscreen"
                            >
                              <span aria-hidden="true">⛶</span>
                            </button>
                          </div>
                        </div>
                    </div>
                  )
                }

                if (mediaIndex !== firstImageMediaIndex) {
                  return null
                }

                if (mobileImages.length > 1) {
                  return (
                    <div
                      class="mobile-image-slideshow"
                      data-mobile-image-slideshow
                      aria-label={`${project.headline || 'Project'} images`}
                    >
                      <div
                        class="mobile-image-track"
                        data-mobile-image-track
                      >
                        {mobileImages.map((image) => (
                          <div class="mobile-image-slide">
                            <img
                              src={sanityImage(image.url, 1024)}
                              srcset={sanitySrcset(image.url)}
                              sizes="100vw"
                              width={image.width}
                              height={image.height}
                              alt={image.alt}
                              decoding="async"
                              draggable="false"
                            />
                          </div>
                        ))}
                      </div>

                      <button
                        class="mobile-slide-zone mobile-slide-zone-prev"
                        type="button"
                        data-mobile-slide-prev
                        aria-label="Previous image"
                      ></button>

                      <button
                        class="mobile-slide-zone mobile-slide-zone-next"
                        type="button"
                        data-mobile-slide-next
                        aria-label="Next image"
                      ></button>
                    </div>
                  )
                }

                if (mobileImages.length === 1) {
                  return (
                    <div class="mobile-media-item">
                      <img
                        src={sanityImage(mobileImages[0].url, 1024)}
                        srcset={sanitySrcset(mobileImages[0].url)}
                        sizes="100vw"
                        width={mobileImages[0].width}
                        height={mobileImages[0].height}
                        alt={mobileImages[0].alt}
                        decoding="async"
                      />
                    </div>
                  )
                }

                return null
              })}
            </div>

            <div class="meta">
              <p>Brand: {project.brand}</p>
              <p>Project: {project.projectName}</p>
              <p class="secondary-meta">Role: {project.role}</p>
              <p class="secondary-meta">Agency: {project.agency}</p>
            </div>

            <div class="description" data-project-description>
              <div
                class="description-version short-description"
                data-short-description
              >
                {project.description?.map((block) =>
                  block._type === 'block' ? (
                    <p>
                      {block.children?.map((child) => child.text).join('')}
                    </p>
                  ) : null
                )}
              </div>

              {
                project.enableReadMore && project.longDescription?.length ? (
                  <>
                    <div
                      class="description-version long-description"
                      data-long-description
                      hidden
                    >
                      {project.longDescription.map((block) =>
                        block._type === 'block' ? (
                          <p>
                            {block.children?.map((child) => child.text).join('')}
                          </p>
                        ) : null
                      )}
                    </div>

                    <button
                      class="read-more"
                      type="button"
                      data-read-more
                      aria-expanded="false"
                    >
                      Read more
                    </button>
                  </>
                ) : null
              }
            </div>
          </section>
        )
      })
    }
  </main>
</Layout>

<style>
  .project {
    padding: var(--project-top-space) var(--project-gutter) var(--project-bottom-space);
    scroll-margin-top: 0;
  }

h2 {
  width: min(1180px, 92%);
  margin: 0 auto var(--project-headline-bottom-space);

  font-family: var(--font-display);
  font-size: var(--project-headline-size);
  font-weight: 300;
  line-height: var(--project-headline-line-height);
  letter-spacing: var(--project-headline-letter-spacing);

  text-align: center;
  text-wrap: balance;
}

  .tags {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 28px;
  }

  .project-tag {
    padding: 10px 13px 8px;
    border: 1px solid #292929;
    border-radius: 4px;
    background: var(--near-black);
    font-family: 'Aeonik Fono', monospace;
    font-size: var(--project-tag-size);
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #aaa;
    cursor: pointer;
    transition: border-color 160ms ease, color 160ms ease, opacity 160ms ease;
  }

  .project-tag:hover,
  .project-tag:focus-visible,
  .project-tag[aria-pressed='true'] {
    border-color: #777;
    color: var(--white);
  }

  .project-tag:focus-visible {
    outline: none;
  }

  .tag-clear {
    display: none;
  }

  .project-tag[aria-pressed='true'] .tag-clear {
    display: inline;
  }

  .project {
    transition: opacity 180ms ease;
  }

  .project.is-filtering-out {
    opacity: 0;
  }

  .project[hidden] {
    display: none;
  }

  /*
    Strong Cargo-style scroll reveal.
    Projects start visually black/invisible and slide upward into place.
  */
  .project[data-reveal-ready] > * {
    opacity: 0;
    transform: translateY(var(--reveal-distance));
    transition:
      opacity var(--reveal-opacity-duration) var(--reveal-ease),
      transform var(--reveal-duration) var(--reveal-ease);
    will-change: opacity, transform;
  }

  .project[data-reveal-ready].is-revealed > * {
    opacity: 1;
    transform: translateY(0);
  }

  /* A small stagger makes the arrival feel more designed */
  .project[data-reveal-ready].is-revealed > :nth-child(2) {
    transition-delay: 60ms;
  }

  .project[data-reveal-ready].is-revealed > :nth-child(3) {
    transition-delay: 120ms;
  }

  .project[data-reveal-ready].is-revealed > :nth-child(4) {
    transition-delay: 180ms;
  }

  .project[data-reveal-ready].is-revealed > :nth-child(n + 5) {
    transition-delay: 240ms;
  }

  .media-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--project-media-gap);
  }

  .mobile-media {
    display: none;
  }

  .media-item.full {
    grid-column: 1 / -1;
  }

  .media-item.half {
    grid-column: span 1;
  }

  .media-item > img,
  .media-item > video {
    display: block;
    width: 100%;
    height: auto;
  }

  .project-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: var(--project-media-gap);
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .project-gallery img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-slideshow {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .slideshow-viewport {
    width: 100%;
    overflow: hidden;
  }

  .slideshow-track {
    display: flex;
    width: 100%;
    transition: transform 500ms cubic-bezier(.76, 0, .24, 1);
    will-change: transform;
  }

  .slideshow-slide {
    flex: 0 0 100%;
    width: 100%;
  }

  .slideshow-slide img {
    display: block;
    width: 100%;
    height: auto;
  }

  .slideshow-control {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 2;
    width: 50%;
    padding: 0;
    border: 0;
    background: transparent;
    color: white;
    cursor: pointer;
  }

  .slideshow-control-prev {
    left: 0;
  }

  .slideshow-control-next {
    right: 0;
  }

  .slideshow-control span {
    position: absolute;
    top: 50%;
    font-family: 'Aeonik Fono', monospace;
    font-size: 26px;
    line-height: 1;
    opacity: 0;
    transform: translateY(-50%);
    transition: opacity 150ms ease;
  }

  .slideshow-control-prev span {
    left: 22px;
  }

  .slideshow-control-next span {
    right: 22px;
  }

  .slideshow-control:hover span,
  .slideshow-control:focus-visible span {
    opacity: 1;
  }

  .slideshow-control:focus-visible {
    outline: none;
  }

.meta {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--project-media-gap);
  margin-top: var(--project-meta-top-space);

  font-size: var(--project-meta-size);
  line-height: var(--project-meta-line-height);
  color: var(--project-meta-color);
}

  .meta p {
    margin: 0;
  }

  .description {
    width: min(720px, 100%);
    margin: 58px auto 0;
   font-size: var(--project-body-size);
line-height: var(--project-body-line-height);
    color: #888;
  }

  .description p {
    margin: 0 0 18px;
  }

  .description-version p:first-child {
    text-indent: 2em;
  }

  .read-more {
    margin: 12px 0 0;
    padding: 0;
    border: 0;
    background: transparent;
    font-family: 'Aeonik Fono', monospace;
    font-size: inherit;
    color: #888;
    cursor: pointer;
  }

  .read-more:hover {
    color: white;
  }


  /* Custom video player */
  .custom-video-player {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--black);
  }

  .custom-video-player video {
    display: block;
    width: 100%;
    height: auto;
  }

  .video-play-large {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.22);
    transform: translate(-50%, -50%);
    cursor: pointer;
  }

  .video-play-large span {
    display: block;
    width: 0;
    height: 0;
    margin-left: 4px;
    border-top: 10px solid transparent;
    border-bottom: 10px solid transparent;
    border-left: 16px solid var(--white);
  }

  .custom-video-player.has-started .video-play-large {
    display: none;
  }

  .video-controls {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 64px;
    padding: 24px 16px 14px;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.72),
      rgba(0, 0, 0, 0)
    );
    opacity: 0;
    pointer-events: none;
    transition: opacity 160ms ease;
  }

  .custom-video-player.has-started:hover .video-controls,
  .custom-video-player.has-started:focus-within .video-controls {
    opacity: 1;
    pointer-events: auto;
  }

  .video-control-button {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--white);
    font-family: 'Aeonik Fono', monospace;
    font-size: 13px;
    line-height: 1;
    cursor: pointer;
  }

  .video-progress {
    flex: 1 1 auto;
    min-width: 0;
    height: 2px;
    margin: 0;
    appearance: none;
    border: 0;
    background: rgba(255, 255, 255, 0.35);
    cursor: pointer;
  }

  .video-progress::-webkit-slider-thumb {
    width: 10px;
    height: 10px;
    appearance: none;
    border: 0;
    border-radius: 50%;
    background: var(--white);
  }

  .video-progress::-moz-range-thumb {
    width: 10px;
    height: 10px;
    border: 0;
    border-radius: 50%;
    background: var(--white);
  }

  .video-time {
    flex: 0 0 auto;
    min-width: 34px;
    font-family: 'Aeonik Fono', monospace;
    font-size: 10px;
    line-height: 1;
    color: var(--white);
  }

  @media (hover: none) {
    .custom-video-player.has-started .video-controls {
      opacity: 1;
      pointer-events: auto;
    }
  }

  @media (max-width: 700px) {
    .project {
      padding: var(--project-top-space-mobile) var(--project-gutter-mobile) var(--project-bottom-space-mobile);
    }

h2 {
      width: 100%;
      margin-bottom: var(--project-headline-bottom-space);
      font-size: var(--project-headline-size-mobile);
      line-height: var(--project-headline-line-height);
      letter-spacing: var(--project-headline-letter-spacing);
      text-wrap: balance;
    }

    .tags {
      gap: 7px;
      margin-bottom: 22px;
    }

    .project-tag {
      padding: 8px 10px 7px;
      font-size: var(--project-tag-size-mobile);
    }

    .desktop-media {
      display: none;
    }

    .mobile-media {
      display: flex;
      flex-direction: column;
      gap: 12px;
      width: calc(100% + (var(--project-gutter-mobile) * 2));
      margin-left: calc(var(--project-gutter-mobile) * -1);
      margin-right: calc(var(--project-gutter-mobile) * -1);
    }

    .mobile-media-item,
    .mobile-media-item > img {
      display: block;
      width: 100%;
    }

    .mobile-media-item > img {
      height: auto;
    }

    .mobile-image-slideshow {
      position: relative;
      isolation: isolate;
      width: 100%;
      overflow: hidden;
      touch-action: pan-y;
      user-select: none;
    }

    .mobile-image-track {
      display: flex;
      width: 100%;
      transition: transform 420ms cubic-bezier(.76, 0, .24, 1);
      will-change: transform;
    }

    .mobile-image-slide {
      flex: 0 0 100%;
      width: 100%;
    }

    .mobile-image-slide img {
      display: block;
      width: 100%;
      height: auto;
      pointer-events: none;
    }

    .mobile-slide-zone {
      position: absolute;
      top: 0;
      bottom: 0;
      z-index: 2;
      width: 50%;
      padding: 0;
      border: 0;
      background: transparent;
    }

    .mobile-slide-zone-prev {
      left: 0;
    }

    .mobile-slide-zone-next {
      right: 0;
    }

    .slideshow-control span {
      display: none;
    }

.meta {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  margin-top: var(--project-meta-top-space);
  font-size: var(--project-meta-size-mobile);
  line-height: var(--project-meta-line-height);
}

    .secondary-meta {
      display: none;
    }

    .description {
      margin-top: 42px;
      font-size: var(--project-body-size-mobile);
      line-height: var(--project-body-line-height);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project[data-reveal-ready] > * {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .slideshow-track {
      transition: none;
    }
  }
</style>

<script>
  const videoPlayers = document.querySelectorAll('[data-video-player]')

  // Load video files only when their player is approaching the viewport.
  // Posters remain available immediately, so the player still has a visual preview.
  const loadVideoSource = (video) => {
    if (!(video instanceof HTMLVideoElement)) return
    if (video.dataset.sourceLoaded === 'true') return

    const source = video.querySelector('source[data-src]')
    if (!(source instanceof HTMLSourceElement)) return

    source.src = source.dataset.src || ''
    source.removeAttribute('data-src')
    video.dataset.sourceLoaded = 'true'
    video.load()
  }

  const videoProjectsPanel = document.querySelector('.projects-view')

  if ('IntersectionObserver' in window && videoProjectsPanel instanceof Element) {
    const videoLoadObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return

          const player = entry.target
          const video = player.querySelector('[data-video]')

          loadVideoSource(video)
          observer.unobserve(player)
        })
      },
      {
        root: videoProjectsPanel,
        threshold: 0,
        rootMargin: '100% 0px 100% 0px',
      }
    )

    videoPlayers.forEach((player) => videoLoadObserver.observe(player))
  } else {
    // Safe fallback for older browsers.
    videoPlayers.forEach((player) => {
      const video = player.querySelector('[data-video]')
      loadVideoSource(video)
    })
  }

  function formatTime(seconds) {
    if (!Number.isFinite(seconds)) return '0:00'

    const minutes = Math.floor(seconds / 60)
    const remainingSeconds = Math.floor(seconds % 60)
      .toString()
      .padStart(2, '0')

    return `${minutes}:${remainingSeconds}`
  }

  videoPlayers.forEach((player) => {
    const video = player.querySelector('[data-video]')
    const largePlay = player.querySelector('[data-video-play-large]')
    const playButton = player.querySelector('[data-video-play]')
    const playIcon = player.querySelector('[data-video-play-icon]')
    const progress = player.querySelector('[data-video-progress]')
    const time = player.querySelector('[data-video-time]')
    const muteButton = player.querySelector('[data-video-mute]')
    const muteIcon = player.querySelector('[data-video-mute-icon]')
    const fullscreenButton = player.querySelector('[data-video-fullscreen]')

    if (!(video instanceof HTMLVideoElement)) return
    if (!(largePlay instanceof HTMLButtonElement)) return
    if (!(playButton instanceof HTMLButtonElement)) return
    if (!(progress instanceof HTMLInputElement)) return
    if (!(time instanceof HTMLElement)) return
    if (!(muteButton instanceof HTMLButtonElement)) return
    if (!(fullscreenButton instanceof HTMLButtonElement)) return

    // Sound is on by default. Setting this explicitly also avoids
    // Safari/iOS retaining a muted state from a previous media session.
    video.defaultMuted = false
    video.muted = false
    video.volume = 1

    const updatePlayState = () => {
      if (playIcon instanceof HTMLElement) {
        playIcon.textContent = video.paused ? '▶' : 'Ⅱ'
      }

      playButton.setAttribute(
        'aria-label',
        video.paused ? 'Play video' : 'Pause video'
      )
    }

    const updateMuteState = () => {
      if (muteIcon instanceof HTMLElement) {
        muteIcon.textContent = video.muted ? 'M' : 'S'
      }

      muteButton.setAttribute(
        'aria-label',
        video.muted ? 'Unmute video' : 'Mute video'
      )
    }

    const updateProgress = () => {
      const duration = video.duration || 0
      const ratio = duration ? video.currentTime / duration : 0

      progress.value = String(Math.round(ratio * 1000))
      time.textContent = formatTime(video.currentTime)
    }

    const togglePlay = async () => {
      // A direct tap/click should always load the source immediately,
      // even if IntersectionObserver has not fired yet.
      loadVideoSource(video)

      if (video.paused) {
        // This runs inside the user's tap/click, which is the safest place
        // to enable audio on iPhone/Safari.
        video.defaultMuted = false
        video.muted = false
        video.volume = 1
        updateMuteState()

        player.classList.add('has-started')
        await video.play()
      } else {
        video.pause()
      }
    }

    largePlay.addEventListener('click', togglePlay)
    playButton.addEventListener('click', togglePlay)

    video.addEventListener('click', () => {
      if (player.classList.contains('has-started')) {
        togglePlay()
      }
    })

    video.addEventListener('play', updatePlayState)
    video.addEventListener('pause', updatePlayState)
    video.addEventListener('timeupdate', updateProgress)
    video.addEventListener('loadedmetadata', updateProgress)

    progress.addEventListener('input', () => {
      if (!video.duration) return
      video.currentTime = (Number(progress.value) / 1000) * video.duration
    })

    muteButton.addEventListener('click', () => {
      video.muted = !video.muted
      updateMuteState()
    })

    fullscreenButton.addEventListener('click', async () => {
      if (!document.fullscreenElement) {
        if (player.requestFullscreen) {
          await player.requestFullscreen()
        }
      } else if (document.exitFullscreen) {
        await document.exitFullscreen()
      }
    })

    updatePlayState()
    updateMuteState()
    updateProgress()
  })
  // Unified mobile project-image slideshows
  const mobileSlideshows = document.querySelectorAll(
    '[data-mobile-image-slideshow]'
  )

  mobileSlideshows.forEach((slideshow) => {
    const track = slideshow.querySelector('[data-mobile-image-track]')
    const slides = Array.from(slideshow.querySelectorAll('.mobile-image-slide'))
    const previousButton = slideshow.querySelector('[data-mobile-slide-prev]')
    const nextButton = slideshow.querySelector('[data-mobile-slide-next]')

    if (!(track instanceof HTMLElement)) return
    if (!(previousButton instanceof HTMLButtonElement)) return
    if (!(nextButton instanceof HTMLButtonElement)) return
    if (!slides.length) return

    let current = 0
    let pointerStartX = null
    let autoplayInterval = null

    const render = () => {
      track.style.transform = `translateX(-${current * 100}%)`
    }

    const show = (index) => {
      current = (index + slides.length) % slides.length
      render()
    }

    const stopAutoplay = () => {
      if (autoplayInterval) {
        window.clearInterval(autoplayInterval)
        autoplayInterval = null
      }
    }

    const startAutoplay = () => {
      stopAutoplay()

      if (slides.length < 2) return
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return

      autoplayInterval = window.setInterval(() => {
        show(current + 1)
      }, 4000)
    }

    previousButton.addEventListener('click', () => {
      stopAutoplay()
      show(current - 1)
    })

    nextButton.addEventListener('click', () => {
      stopAutoplay()
      show(current + 1)
    })

    slideshow.addEventListener('pointerdown', (event) => {
      stopAutoplay()
      pointerStartX = event.clientX
    })

    slideshow.addEventListener('pointerup', (event) => {
      if (pointerStartX === null) return

      const distance = event.clientX - pointerStartX
      pointerStartX = null

      if (Math.abs(distance) < 40) return

      if (distance < 0) {
        show(current + 1)
      } else {
        show(current - 1)
      }
    })

    slideshow.addEventListener('pointercancel', () => {
      pointerStartX = null
    })

    render()
    startAutoplay()

    const handleResize = () => {
      render()
    }

    window.addEventListener('resize', handleResize)
  })

  // Strong project scroll-in reveal
  const revealProjects = Array.from(document.querySelectorAll('[data-project]'))
  const projectsPanel = document.querySelector('.projects-view')

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    revealProjects.forEach((project, index) => {
      project.setAttribute('data-reveal-ready', '')

      // Keep the first project present on initial load.
      if (index === 0) {
        project.classList.add('is-revealed')
      }
    })

    if (projectsPanel instanceof Element) {
      const revealObserver = new IntersectionObserver(
        (entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return

            entry.target.classList.add('is-revealed')
            observer.unobserve(entry.target)
          })
        },
        {
          root: projectsPanel,
          threshold: 0.08,
          rootMargin: '0px 0px -12% 0px',
        }
      )

      revealProjects.slice(1).forEach((project) => revealObserver.observe(project))
    }
  }

  // Project tag filtering
  const allProjects = Array.from(document.querySelectorAll('[data-project]'))
  const allTagButtons = Array.from(document.querySelectorAll('[data-project-tag]'))

  const normaliseTag = (tag) =>
    String(tag || '').trim().toLowerCase()

  let activeTag = null
  let filterTimer = null

  const projectHasTag = (project, tag) => {
    const tags = String(project.getAttribute('data-project-tags') || '')
      .split('|')
      .map(normaliseTag)
      .filter(Boolean)

    return tags.includes(tag)
  }

  const updateTagButtons = () => {
    allTagButtons.forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return
      const buttonTag = normaliseTag(button.dataset.tag)
      button.setAttribute(
        'aria-pressed',
        activeTag && buttonTag === activeTag ? 'true' : 'false'
      )
    })
  }

  const updateTagUrl = () => {
    const url = new URL(window.location.href)

    if (activeTag) {
      url.searchParams.set('tag', activeTag)
    } else {
      url.searchParams.delete('tag')
    }

    window.history.replaceState({}, '', url)
  }

  const applyProjectFilter = ({scrollToFirst = false} = {}) => {
    if (filterTimer) window.clearTimeout(filterTimer)

    const matchingProjects = allProjects.filter((project) =>
      activeTag ? projectHasTag(project, activeTag) : true
    )

    allProjects.forEach((project) => {
      const shouldShow = matchingProjects.includes(project)

      if (shouldShow) {
        project.hidden = false
        requestAnimationFrame(() => {
          project.classList.remove('is-filtering-out')
        })
      } else {
        project.classList.add('is-filtering-out')
      }
    })

    filterTimer = window.setTimeout(() => {
      allProjects.forEach((project) => {
        project.hidden = !matchingProjects.includes(project)
      })

      if (scrollToFirst && matchingProjects.length) {
        matchingProjects[0].scrollIntoView({
          behavior: 'smooth',
          block: 'start',
        })
      }
    }, 180)

    updateTagButtons()
    updateTagUrl()
  }

  allTagButtons.forEach((button) => {
    if (!(button instanceof HTMLButtonElement)) return

    button.addEventListener('click', () => {
      const clickedTag = normaliseTag(button.dataset.tag)
      if (!clickedTag) return

      activeTag = activeTag === clickedTag ? null : clickedTag
      applyProjectFilter({scrollToFirst: true})
    })
  })

  const tagFromUrl = normaliseTag(
    new URL(window.location.href).searchParams.get('tag')
  )

  if (tagFromUrl) {
    const tagExists = allTagButtons.some(
      (button) => normaliseTag(button.dataset.tag) === tagFromUrl
    )

    if (tagExists) {
      activeTag = tagFromUrl
      applyProjectFilter()
    }
  }

  // Read more / read less
  const descriptions = document.querySelectorAll('[data-project-description]')

  function closeDescription(description) {
    const short = description.querySelector('[data-short-description]')
    const long = description.querySelector('[data-long-description]')
    const button = description.querySelector('[data-read-more]')

    if (!(short instanceof HTMLElement)) return
    if (!(long instanceof HTMLElement)) return
    if (!(button instanceof HTMLButtonElement)) return

    short.hidden = false
    long.hidden = true
    button.textContent = 'Read more'
    button.setAttribute('aria-expanded', 'false')
    description.removeAttribute('data-expanded')
  }

  function openDescription(description) {
    const short = description.querySelector('[data-short-description]')
    const long = description.querySelector('[data-long-description]')
    const button = description.querySelector('[data-read-more]')

    if (!(short instanceof HTMLElement)) return
    if (!(long instanceof HTMLElement)) return
    if (!(button instanceof HTMLButtonElement)) return

    short.hidden = true
    long.hidden = false
    button.textContent = 'Read less'
    button.setAttribute('aria-expanded', 'true')
    description.setAttribute('data-expanded', 'true')
  }

  descriptions.forEach((description) => {
    const button = description.querySelector('[data-read-more]')

    if (!(button instanceof HTMLButtonElement)) return

    button.addEventListener('click', () => {
      const isExpanded = description.hasAttribute('data-expanded')

      if (isExpanded) {
        closeDescription(description)
      } else {
        openDescription(description)
      }
    })
  })

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return

    const expandedDescription = document.querySelector(
      '[data-project-description][data-expanded]'
    )

    if (!expandedDescription) return

    const positionBeforeCollapse =
      expandedDescription.getBoundingClientRect().top

    closeDescription(expandedDescription)

    if (positionBeforeCollapse < 0) {
      expandedDescription.scrollIntoView({
        behavior: 'smooth',
        block: 'start',
      })
    }
  })

  // Individual project media slideshows
  const slideshows = document.querySelectorAll('[data-project-slideshow]')

  slideshows.forEach((slideshow) => {
    const track = slideshow.querySelector('[data-slideshow-track]')
    const slides = Array.from(
      slideshow.querySelectorAll('.slideshow-slide')
    )
    const previousButton = slideshow.querySelector('[data-slideshow-prev]')
    const nextButton = slideshow.querySelector('[data-slideshow-next]')

    if (!(track instanceof HTMLElement)) return
    if (!(previousButton instanceof HTMLButtonElement)) return
    if (!(nextButton instanceof HTMLButtonElement)) return
    if (slides.length < 2) return

    let current = 0
    let interval

    function renderSlide() {
      track.style.transform = `translateX(-${current * 100}%)`
    }

    function showSlide(index) {
      current = (index + slides.length) % slides.length
      renderSlide()
    }

    function nextSlide() {
      showSlide(current + 1)
    }

    function previousSlide() {
      showSlide(current - 1)
    }

    function startAutoplay() {
      interval = window.setInterval(nextSlide, 4000)
    }

    function stopAutoplay() {
      if (interval) {
        window.clearInterval(interval)
        interval = undefined
      }
    }

    previousButton.addEventListener('click', (event) => {
      event.stopPropagation()
      stopAutoplay()
      previousSlide()
    })

    nextButton.addEventListener('click', (event) => {
      event.stopPropagation()
      stopAutoplay()
      nextSlide()
    })

    renderSlide()
    startAutoplay()
  })

  // Arrow-key navigation between projects.
  // Normal scrolling is untouched; this only responds to deliberate ↑ / ↓ presses.
  const getVisibleProjectSections = () =>
    Array.from(document.querySelectorAll('[data-project]')).filter(
      (project) => !project.hidden
    )

  function isTypingOrUsingControl() {
    const active = document.activeElement

    if (!(active instanceof HTMLElement)) return false

    return Boolean(
      active.closest(
        'input, textarea, select, button, a, [contenteditable="true"]'
      )
    )
  }

  function getCurrentProjectIndex(projectSections) {
    const marker = window.innerHeight * 0.35

    let bestIndex = 0
    let bestDistance = Number.POSITIVE_INFINITY

    projectSections.forEach((project, index) => {
      const rect = project.getBoundingClientRect()

      if (rect.top <= marker && rect.bottom > marker) {
        bestIndex = index
        bestDistance = 0
        return
      }

      const distance = Math.abs(rect.top - marker)

      if (distance < bestDistance) {
        bestDistance = distance
        bestIndex = index
      }
    })

    return bestIndex
  }

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return
    if (event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return
    if (isTypingOrUsingControl()) return
    if (!document.documentElement.classList.contains('view-home')) return
    const projectSections = getVisibleProjectSections()

    if (!projectSections.length) return

    const currentIndex = getCurrentProjectIndex(projectSections)

    const targetIndex =
      event.key === 'ArrowDown'
        ? Math.min(currentIndex + 1, projectSections.length - 1)
        : Math.max(currentIndex - 1, 0)

    if (targetIndex === currentIndex) return

    event.preventDefault()

    projectSections[targetIndex].scrollIntoView({
      behavior: 'smooth',
      block: 'start',
    })
  })
</script>
