.meta {
  display: flex;
  width: 100%;
  gap: 16px;
  margin-top: var(--project-meta-top-space);

  overflow-x: scroll;
  overflow-y: hidden;

  -webkit-overflow-scrolling: touch;
  touch-action: pan-x;
  scroll-snap-type: x proximity;
  scrollbar-width: none;

  font-size: var(--project-meta-size-mobile);
  line-height: var(--project-meta-line-height);
  color: var(--project-meta-color);
}

.meta::-webkit-scrollbar {
  display: none;
}

.meta > p {
  flex: 0 0 calc(50% - 8px);
  min-width: 0;
  scroll-snap-align: start;
}

.secondary-meta {
  display: block;
}

  

    .description {
      margin-top: 42px;
      font-size: var(--project-body-size-mobile);
      line-height: var(--project-body-line-height);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project[data-reveal-ready] > * {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .slideshow-track {
      transition: none;
