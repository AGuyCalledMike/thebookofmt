<script>
  // Film videos use a small custom control bar BELOW the video.
  // There is no visual overlay on the <video>, specifically to avoid Safari's
  // video compositing/repaint problems.
  const filmPlayers = document.querySelectorAll('[data-film-player]')

  const formatFilmTime = (seconds) => {
    if (!Number.isFinite(seconds) || seconds < 0) return '00:00'

    const totalSeconds = Math.floor(seconds)
    const minutes = Math.floor(totalSeconds / 60)
    const remainingSeconds = totalSeconds % 60

    return `${String(minutes).padStart(2, '0')}:${String(remainingSeconds).padStart(2, '0')}`
  }

  filmPlayers.forEach((player) => {
    if (!(player instanceof HTMLElement)) return

    const video = player.querySelector('video')
    const playButton = player.querySelector('[data-film-play]')
    const progress = player.querySelector('[data-film-progress]')
    const time = player.querySelector('[data-film-time]')
    const muteButton = player.querySelector('[data-film-mute]')

    if (!(video instanceof HTMLVideoElement)) return
    if (!(playButton instanceof HTMLButtonElement)) return
    if (!(progress instanceof HTMLInputElement)) return
    if (!(time instanceof HTMLElement)) return
    if (!(muteButton instanceof HTMLButtonElement)) return

    const updatePlayState = () => {
      const isPlaying = !video.paused && !video.ended
      playButton.textContent = isPlaying ? 'PAUSE' : 'PLAY'
      playButton.setAttribute('aria-label', isPlaying ? 'Pause video' : 'Play video')
    }

    const updateMuteState = () => {
      const isMuted = video.muted || video.volume === 0
      muteButton.textContent = isMuted ? 'SOUND' : 'MUTE'
      muteButton.setAttribute('aria-label', isMuted ? 'Unmute video' : 'Mute video')
    }

    const updateTimeline = () => {
      const duration = Number.isFinite(video.duration) ? video.duration : 0
      const current = Number.isFinite(video.currentTime) ? video.currentTime : 0
      const percentage = duration > 0 ? (current / duration) * 100 : 0

      progress.value = String(percentage)
      progress.style.setProperty('--film-progress', `${percentage}%`)
      time.textContent = `${formatFilmTime(current)} / ${formatFilmTime(duration)}`
    }

    const togglePlayback = () => {
      if (video.paused || video.ended) {
        const playPromise = video.play()
        if (playPromise instanceof Promise) {
          playPromise.catch(() => {})
        }
      } else {
        video.pause()
      }
    }

    playButton.addEventListener('click', togglePlayback)
    video.addEventListener('click', togglePlayback)

    muteButton.addEventListener('click', () => {
      video.muted = !video.muted
    })

    progress.addEventListener('input', () => {
      if (!Number.isFinite(video.duration) || video.duration <= 0) return

      video.currentTime = (Number(progress.value) / 100) * video.duration
      updateTimeline()
    })

    video.addEventListener('play', updatePlayState)
    video.addEventListener('pause', updatePlayState)
    video.addEventListener('ended', updatePlayState)
    video.addEventListener('volumechange', updateMuteState)
    video.addEventListener('loadedmetadata', updateTimeline)
    video.addEventListener('durationchange', updateTimeline)
    video.addEventListener('timeupdate', updateTimeline)

    updatePlayState()
    updateMuteState()
    updateTimeline()
  })

  // Load Film metadata shortly before a film reaches the viewport.
  // Hidden desktop/mobile duplicates stay unloaded.
  const filmPreloadObserver = new IntersectionObserver(
    (entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return

        const video = entry.target

        if (video instanceof HTMLVideoElement) {
          video.preload = 'metadata'
          video.load()
          observer.unobserve(video)
        }
      })
    },
    {
      rootMargin: '500px 0px',
    }
  )

  // Pause Film videos when they are completely outside the viewport.
  // Returning to them does not automatically resume playback.
  const filmViewportObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) return

      const video = entry.target

      if (video instanceof HTMLVideoElement && !video.paused) {
        video.pause()
      }
    })
  })

  document.querySelectorAll('[data-film-player] video').forEach((video) => {
    filmPreloadObserver.observe(video)
    filmViewportObserver.observe(video)
  })

  // Loop videos load shortly before view, play only while visible,
  // and pause once they leave the viewport.
  const loopVideos = document.querySelectorAll('.loop-video video')

  const loopPreloadObserver = new IntersectionObserver(
    (entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return

        const video = entry.target

        if (video instanceof HTMLVideoElement) {
          video.preload = 'auto'
          video.load()
          observer.unobserve(video)
        }
      })
    },
    {
      rootMargin: '500px 0px',
    }
  )

  const loopPlaybackObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const video = entry.target
        if (!(video instanceof HTMLVideoElement)) return

        if (entry.isIntersecting) {
          const playPromise = video.play()

          if (playPromise instanceof Promise) {
            playPromise.catch(() => {})
          }
        } else if (!video.paused) {
          video.pause()
        }
      })
    },
    {
      threshold: 0.05,
    }
  )

  loopVideos.forEach((video) => {
    loopPreloadObserver.observe(video)
    loopPlaybackObserver.observe(video)
  })

  // Unified mobile project-image slideshows
  const mobileSlideshows = document.querySelectorAll(
    '[data-mobile-image-slideshow]'
  )

  mobileSlideshows.forEach((slideshow) => {
    const track = slideshow.querySelector('[data-mobile-image-track]')
    const slides = Array.from(slideshow.querySelectorAll('.mobile-image-slide'))
    const previousButton = slideshow.querySelector('[data-mobile-slide-prev]')
    const nextButton = slideshow.querySelector('[data-mobile-slide-next]')

    if (!(track instanceof HTMLElement)) return
    if (!(previousButton instanceof HTMLButtonElement)) return
    if (!(nextButton instanceof HTMLButtonElement)) return
    if (!slides.length) return

    let current = 0
    let pointerStartX = null
    let autoplayInterval = null

    const render = () => {
      track.style.transform = `translateX(-${current * 100}%)`
    }

    const show = (index) => {
      current = (index + slides.length) % slides.length
      render()
    }

    const stopAutoplay = () => {
      if (autoplayInterval) {
        window.clearInterval(autoplayInterval)
        autoplayInterval = null
      }
    }

    const startAutoplay = () => {
      stopAutoplay()

      if (slides.length < 2) return
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return

      autoplayInterval = window.setInterval(() => {
        show(current + 1)
      }, 4000)
    }

    previousButton.addEventListener('click', () => {
      stopAutoplay()
      show(current - 1)
    })

    nextButton.addEventListener('click', () => {
      stopAutoplay()
      show(current + 1)
    })

    slideshow.addEventListener('pointerdown', (event) => {
      stopAutoplay()
      pointerStartX = event.clientX
    })

    slideshow.addEventListener('pointerup', (event) => {
      if (pointerStartX === null) return

      const distance = event.clientX - pointerStartX
      pointerStartX = null

      if (Math.abs(distance) < 40) return

      if (distance < 0) {
        show(current + 1)
      } else {
        show(current - 1)
      }
    })

    slideshow.addEventListener('pointercancel', () => {
      pointerStartX = null
    })

    render()
    startAutoplay()
  })

  // Strong project scroll-in reveal
  const revealProjects = Array.from(document.querySelectorAll('[data-project]'))
  const projectsPanel = document.querySelector('.projects-view')

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    revealProjects.forEach((project, index) => {
      project.setAttribute('data-reveal-ready', '')

      // Keep the first project present on initial load.
      if (index === 0) {
        project.classList.add('is-revealed')
      }
    })

    if (projectsPanel instanceof Element) {
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed')
            } else {
              entry.target.classList.remove('is-revealed')
            }
          })
        },
        {
          root: projectsPanel,
          threshold: 0.08,
          rootMargin: '0px 0px -12% 0px',
        }
      )

      revealProjects.forEach((project) => revealObserver.observe(project))
    }
  }

  // Project tag filtering
  const allProjects = Array.from(document.querySelectorAll('[data-project]'))
  const allTagButtons = Array.from(document.querySelectorAll('[data-project-tag]'))

  const normaliseTag = (tag) =>
    String(tag || '').trim().toLowerCase()

  let activeTag = null
  let filterTimer = null

  const projectHasTag = (project, tag) => {
    const tags = String(project.getAttribute('data-project-tags') || '')
      .split('|')
      .map(normaliseTag)
      .filter(Boolean)

    return tags.includes(tag)
  }

  const updateTagButtons = () => {
    allTagButtons.forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return
      const buttonTag = normaliseTag(button.dataset.tag)
      button.setAttribute(
        'aria-pressed',
        activeTag && buttonTag === activeTag ? 'true' : 'false'
      )
    })
  }

  const updateTagUrl = () => {
    const url = new URL(window.location.href)

    if (activeTag) {
      url.searchParams.set('tag', activeTag)
    } else {
      url.searchParams.delete('tag')
    }

    window.history.replaceState({}, '', url)
  }

  const applyProjectFilter = ({scrollToFirst = false} = {}) => {
    if (filterTimer) window.clearTimeout(filterTimer)

    const matchingProjects = allProjects.filter((project) =>
      activeTag ? projectHasTag(project, activeTag) : true
    )

    allProjects.forEach((project) => {
      const shouldShow = matchingProjects.includes(project)

      if (shouldShow) {
        project.hidden = false
        requestAnimationFrame(() => {
          project.classList.remove('is-filtering-out')
        })
      } else {
        project.classList.add('is-filtering-out')
      }
    })

    filterTimer = window.setTimeout(() => {
      allProjects.forEach((project) => {
        project.hidden = !matchingProjects.includes(project)
      })

      if (scrollToFirst && matchingProjects.length) {
        matchingProjects[0].scrollIntoView({
          behavior: 'smooth',
          block: 'start',
        })
      }
    }, 180)

    updateTagButtons()
    updateTagUrl()
  }

  allTagButtons.forEach((button) => {
    if (!(button instanceof HTMLButtonElement)) return

    button.addEventListener('click', () => {
      const clickedTag = normaliseTag(button.dataset.tag)
      if (!clickedTag) return

      activeTag = activeTag === clickedTag ? null : clickedTag
      applyProjectFilter({scrollToFirst: true})
    })
  })

  const tagFromUrl = normaliseTag(
    new URL(window.location.href).searchParams.get('tag')
  )

  if (tagFromUrl) {
    const tagExists = allTagButtons.some(
      (button) => normaliseTag(button.dataset.tag) === tagFromUrl
    )

    if (tagExists) {
      activeTag = tagFromUrl
      applyProjectFilter()
    }
  }

  // Internal links from description copy to another project.
  // If a tag filter is active, clear it first so the target project is visible.
  document.querySelectorAll('[data-project-link]').forEach((link) => {
    if (!(link instanceof HTMLAnchorElement)) return

    link.addEventListener('click', (event) => {
      const slug = link.dataset.projectLink
      if (!slug) return

      const target = document.getElementById(`project-${slug}`)
      if (!(target instanceof HTMLElement)) return

      event.preventDefault()

      const scrollToProject = () => {
        target.scrollIntoView({
          behavior: 'smooth',
          block: 'start',
        })

        const url = new URL(window.location.href)
        url.hash = `project-${slug}`
        window.history.replaceState({}, '', url)
      }

      if (activeTag) {
        activeTag = null
        applyProjectFilter()
        window.setTimeout(scrollToProject, 220)
      } else {
        scrollToProject()
      }
    })
  })

  // Read more / read less
  const descriptions = document.querySelectorAll('[data-project-description]')

  function closeDescription(description) {
    const short = description.querySelector('[data-short-description]')
    const long = description.querySelector('[data-long-description]')
    const button = description.querySelector('[data-read-more]')

    if (!(short instanceof HTMLElement)) return
    if (!(long instanceof HTMLElement)) return
    if (!(button instanceof HTMLButtonElement)) return

    short.hidden = false
    long.hidden = true
    button.textContent = 'Read more'
    button.setAttribute('aria-expanded', 'false')
    description.removeAttribute('data-expanded')
  }

  function openDescription(description) {
    const short = description.querySelector('[data-short-description]')
    const long = description.querySelector('[data-long-description]')
    const button = description.querySelector('[data-read-more]')

    if (!(short instanceof HTMLElement)) return
    if (!(long instanceof HTMLElement)) return
    if (!(button instanceof HTMLButtonElement)) return

    short.hidden = true
    long.hidden = false
    button.textContent = 'Read less'
    button.setAttribute('aria-expanded', 'true')
    description.setAttribute('data-expanded', 'true')
  }

  descriptions.forEach((description) => {
    const button = description.querySelector('[data-read-more]')

    if (!(button instanceof HTMLButtonElement)) return

    button.addEventListener('click', () => {
      const isExpanded = description.hasAttribute('data-expanded')

      if (isExpanded) {
        closeDescription(description)
      } else {
        openDescription(description)
      }
    })
  })

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return

    const expandedDescription = document.querySelector(
      '[data-project-description][data-expanded]'
    )

    if (!expandedDescription) return

    const positionBeforeCollapse =
      expandedDescription.getBoundingClientRect().top

    closeDescription(expandedDescription)

    if (positionBeforeCollapse < 0) {
      expandedDescription.scrollIntoView({
        behavior: 'smooth',
        block: 'start',
      })
    }
  })

  // Individual project media slideshows
  const slideshows = document.querySelectorAll('[data-project-slideshow]')

  slideshows.forEach((slideshow) => {
    const track = slideshow.querySelector('[data-slideshow-track]')
    const slides = Array.from(
      slideshow.querySelectorAll('.slideshow-slide')
    )
    const previousButton = slideshow.querySelector('[data-slideshow-prev]')
    const nextButton = slideshow.querySelector('[data-slideshow-next]')

    if (!(track instanceof HTMLElement)) return
    if (!(previousButton instanceof HTMLButtonElement)) return
    if (!(nextButton instanceof HTMLButtonElement)) return
    if (slides.length < 2) return

    let current = 0
    let interval

    function renderSlide() {
      track.style.transform = `translateX(-${current * 100}%)`
    }

    function showSlide(index) {
      current = (index + slides.length) % slides.length
      renderSlide()
    }

    function nextSlide() {
      showSlide(current + 1)
    }

    function previousSlide() {
      showSlide(current - 1)
    }

    function startAutoplay() {
      interval = window.setInterval(nextSlide, 4000)
    }

    function stopAutoplay() {
      if (interval) {
        window.clearInterval(interval)
        interval = undefined
      }
    }

    previousButton.addEventListener('click', (event) => {
      event.stopPropagation()
      stopAutoplay()
      previousSlide()
    })

    nextButton.addEventListener('click', (event) => {
      event.stopPropagation()
      stopAutoplay()
      nextSlide()
    })

    renderSlide()
    startAutoplay()
  })

  // Arrow-key navigation between projects.
  // Normal scrolling is untouched; this only responds to deliberate ↑ / ↓ presses.
  const getVisibleProjectSections = () =>
    Array.from(document.querySelectorAll('[data-project]')).filter(
      (project) => !project.hidden
    )

  function isTypingOrUsingControl() {
    const active = document.activeElement

    if (!(active instanceof HTMLElement)) return false

    return Boolean(
      active.closest(
        'input, textarea, select, button, a, [contenteditable="true"]'
      )
    )
  }

  function getCurrentProjectIndex(projectSections) {
    const marker = window.innerHeight * 0.35

    let bestIndex = 0
    let bestDistance = Number.POSITIVE_INFINITY

    projectSections.forEach((project, index) => {
      const rect = project.getBoundingClientRect()

      if (rect.top <= marker && rect.bottom > marker) {
        bestIndex = index
        bestDistance = 0
        return
      }

      const distance = Math.abs(rect.top - marker)

      if (distance < bestDistance) {
        bestDistance = distance
        bestIndex = index
      }
    })

    return bestIndex
  }

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return
    if (event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return
    if (isTypingOrUsingControl()) return
    if (!document.documentElement.classList.contains('view-home')) return
    const projectSections = getVisibleProjectSections()

    if (!projectSections.length) return

    const currentIndex = getCurrentProjectIndex(projectSections)

    const targetIndex =
      event.key === 'ArrowDown'
        ? Math.min(currentIndex + 1, projectSections.length - 1)
        : Math.max(currentIndex - 1, 0)

    if (targetIndex === currentIndex) return

    event.preventDefault()

    projectSections[targetIndex].scrollIntoView({
      behavior: 'smooth',
      block: 'start',
    })
  })
</script>
