---
import { sanityClient } from 'sanity:client'
import Layout from '../layouts/Layout.astro'

const imageWidths = [480, 768, 1024, 1440, 1920, 2400]

function sanityImage(url, width) {
  if (!url) return undefined

  const separator = url.includes('?') ? '&' : '?'
  return `${url}${separator}auto=format&fit=max&w=${width}&q=82`
}

function sanitySrcset(url) {
  if (!url) return undefined

  return imageWidths
    .map((width) => `${sanityImage(url, width)} ${width}w`)
    .join(', ')
}

const projects = await sanityClient.fetch(`
  *[_type == "project" && hidden != true] | order(orderRank asc, _createdAt asc) {
    _id,
    "slug": slug.current,
    headline,
    tags,
    media[] {
      _key,
      mediaType,
      videoMode,
      width,
      alt,

      image {
        asset-> {
          url,
          metadata {
            dimensions {
              width,
              height,
              aspectRatio
            }
          }
        }
      },

      video {
        asset-> {
          url
        }
      },

      poster {
        asset-> {
          url,
          metadata {
            dimensions {
              width,
              height,
              aspectRatio
            }
          }
        }
      },

      slides[] {
        alt,
        asset-> {
          url,
          metadata {
            dimensions {
              width,
              height,
              aspectRatio
            }
          }
        }
      },

      galleryImages[] {
        alt,
        asset-> {
          url,
          originalFilename,
          metadata {
            dimensions {
              width,
              height,
              aspectRatio
            }
          }
        }
      }
    },

    brand,
    projectName,
    role,
    agency,
    description[] {
      ...,
      markDefs[] {
        ...,
        project-> {
          _id,
          title,
          "slug": slug.current
        }
      }
    },
    enableReadMore,
    longDescription[] {
      ...,
      markDefs[] {
        ...,
        project-> {
          _id,
          title,
          "slug": slug.current
        }
      }
    }
  }
`)
---

<Layout>
  <main>
    {
      projects.map((project) => {
        const media = project.media ?? []

        const mobileImages = media.flatMap((item) => {
          if (item.mediaType === 'image' && item.image?.asset?.url) {
            return [
              {
                key: item._key,
                url: item.image.asset.url,
                alt: item.alt || '',
                width: item.image.asset.metadata?.dimensions?.width,
                height: item.image.asset.metadata?.dimensions?.height,
              },
            ]
          }

          if (item.mediaType === 'slideshow' && item.slides?.length) {
            return item.slides
              .filter((slide) => slide.asset?.url)
              .map((slide, index) => ({
                key: `${item._key}-${index}`,
                url: slide.asset.url,
                alt: slide.alt || '',
                width: slide.asset.metadata?.dimensions?.width,
                height: slide.asset.metadata?.dimensions?.height,
              }))
          }

          if (item.mediaType === 'gallery' && item.galleryImages?.length) {
            return item.galleryImages
              .filter((image) => image.asset?.url)
              .map((image, index) => ({
                key: `${item._key}-gallery-${index}`,
                url: image.asset.url,
                alt: image.alt || image.asset.originalFilename || '',
                width: image.asset.metadata?.dimensions?.width,
                height: image.asset.metadata?.dimensions?.height,
              }))
          }

          return []
        })

        const firstImageMediaIndex = media.findIndex(
          (item) =>
            (item.mediaType === 'image' && item.image?.asset?.url) ||
            (item.mediaType === 'slideshow' &&
              item.slides?.some((slide) => slide.asset?.url)) ||
            (item.mediaType === 'gallery' &&
              item.galleryImages?.some((image) => image.asset?.url))
        )

        return (
          <section
            class="project"
            data-project
            data-project-slug={project.slug}
            data-project-tags={(project.tags ?? []).join('|')}
            id={project.slug ? `project-${project.slug}` : undefined}
          >
            <h2>{project.headline}</h2>

            <div class="tags">
              {project.tags?.map((tag) => (
                <button
                  class="project-tag"
                  type="button"
                  data-project-tag
                  data-tag={tag}
                  aria-pressed="false"
                >
                  <span data-tag-label>{tag}</span>
                  <span class="tag-clear" aria-hidden="true"> ×</span>
                </button>
              ))}
            </div>

            <div class="media-grid desktop-media">
              {project.media?.map((item) => (
                <div
                  class:list={[
                    'media-item',
                    item.width === 'half' ? 'half' : 'full'
                  ]}
                >
                  {
                    item.mediaType === 'video' && item.video?.asset?.url ? (
                      item.videoMode === 'loop' ? (
                        <div class="custom-video-player loop-video">
                          <video
                            muted
                            loop
                            playsinline
                            preload="none"
                          >
                            <source src={item.video.asset.url} />
                          </video>
                        </div>
                      ) : (
                        <div class="film-video" data-film-player>
                          <video
                            playsinline
                            preload="none"
                            poster={sanityImage(item.poster?.asset?.url, 1600)}
                          >
                            <source src={item.video.asset.url} />
                          </video>

                          <div class="film-controls" data-film-controls>
                            <button
                              class="film-control film-play"
                              type="button"
                              data-film-play
                              aria-label="Play video"
                            >
                              PLAY
                            </button>

                            <input
                              class="film-progress"
                              type="range"
                              min="0"
                              max="100"
                              step="0.01"
                              value="0"
                              data-film-progress
                              aria-label="Video progress"
                            />

                            <span class="film-time" data-film-time>00:00 / 00:00</span>

                            <button
                              class="film-control film-mute"
                              type="button"
                              data-film-mute
                              aria-label="Mute video"
                            >
                              MUTE
                            </button>
                          </div>
                        </div>
                      )
                    ) : item.mediaType === 'gallery' && item.galleryImages?.length ? (
                      <div class="project-gallery">
                        {item.galleryImages.map((image) => (
                          image.asset?.url ? (
                            <img
                              src={sanityImage(image.asset.url, 1440)}
                              srcset={sanitySrcset(image.asset.url)}
                              sizes={item.width === 'half'
                                ? '(max-width: 700px) 100vw, 25vw'
                                : '(max-width: 700px) 100vw, 50vw'}
                              width={image.asset.metadata?.dimensions?.width}
                              height={image.asset.metadata?.dimensions?.height}
                              alt={image.alt || image.asset.originalFilename || ''}
                              loading="lazy"
                        decoding="async"
                            />
                          ) : null
                        ))}
                      </div>
                    ) : item.mediaType === 'slideshow' && item.slides?.length ? (
                      <div
                        class="project-slideshow"
                        data-project-slideshow
                      >
                        <div class="slideshow-viewport">
                          <div class="slideshow-track" data-slideshow-track>
                            {item.slides.map((slide) => (
                              <div class="slideshow-slide">
                                <img
                                  src={sanityImage(slide.asset?.url, 1920)}
                                  srcset={sanitySrcset(slide.asset?.url)}
                                  sizes={item.width === 'half'
                                    ? '(max-width: 700px) 100vw, 50vw'
                                    : '100vw'}
                                  width={slide.asset?.metadata?.dimensions?.width}
                                  height={slide.asset?.metadata?.dimensions?.height}
                                  alt={slide.alt || ''}
                                  loading="lazy"
                        decoding="async"
                                />
                              </div>
                            ))}
                          </div>
                        </div>

                        <button
                          class="slideshow-control slideshow-control-prev"
                          type="button"
                          data-slideshow-prev
                          aria-label="Previous slide"
                        >
                          <span aria-hidden="true">←</span>
                        </button>

                        <button
                          class="slideshow-control slideshow-control-next"
                          type="button"
                          data-slideshow-next
                          aria-label="Next slide"
                        >
                          <span aria-hidden="true">→</span>
                        </button>
                      </div>
                    ) : item.image?.asset?.url ? (
                      <img
                        src={sanityImage(item.image.asset.url, 1920)}
                        srcset={sanitySrcset(item.image.asset.url)}
                        sizes={item.width === 'half'
                          ? '(max-width: 700px) 100vw, 50vw'
                          : '100vw'}
                        width={item.image.asset.metadata?.dimensions?.width}
                        height={item.image.asset.metadata?.dimensions?.height}
                        alt={item.alt || ''}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : null
                  }
                </div>
              ))}
            </div>


            <div class="mobile-media">
              {media.map((item, mediaIndex) => {
                if (item.mediaType === 'video' && item.video?.asset?.url) {
                  return (
                    <div class="mobile-media-item">
                      {
                        item.videoMode === 'loop' ? (
                          <div class="custom-video-player loop-video">
                            <video
                              muted
                              loop
                              playsinline
                              preload="none"
                              poster={sanityImage(item.poster?.asset?.url, 1600)}
                            >
                              <source src={item.video.asset.url} />
                            </video>
                          </div>
                        ) : (
                          <div class="film-video" data-film-player>
                            <video
                              playsinline
                              preload="none"
                              poster={sanityImage(item.poster?.asset?.url, 1600)}
                            >
                              <source src={item.video.asset.url} />
                            </video>

                            <div class="film-controls" data-film-controls>
                              <button
                                class="film-control film-play"
                                type="button"
                                data-film-play
                                aria-label="Play video"
                              >
                                PLAY
                              </button>

                              <input
                                class="film-progress"
                                type="range"
                                min="0"
                                max="100"
                                step="0.01"
                                value="0"
                                data-film-progress
                                aria-label="Video progress"
                              />

                              <span class="film-time" data-film-time>00:00 / 00:00</span>

                              <button
                                class="film-control film-mute"
                                type="button"
                                data-film-mute
                                aria-label="Mute video"
                              >
                                MUTE
                              </button>
                            </div>
                          </div>
                        )
                      }
                    </div>
                  )
                }

                if (mediaIndex !== firstImageMediaIndex) {
                  return null
                }

                if (mobileImages.length > 1) {
                  return (
                    <div
                      class="mobile-image-slideshow"
                      data-mobile-image-slideshow
                      aria-label={`${project.headline || 'Project'} images`}
                    >
                      <div
                        class="mobile-image-track"
                        data-mobile-image-track
                      >
                        {mobileImages.map((image) => (
                          <div class="mobile-image-slide">
                            <img
                              src={sanityImage(image.url, 1024)}
                              srcset={sanitySrcset(image.url)}
                              sizes="100vw"
                              width={image.width}
                              height={image.height}
                              alt={image.alt}
                              loading="lazy"
                        decoding="async"
                              draggable="false"
                            />
                          </div>
                        ))}
                      </div>

                      <button
                        class="mobile-slide-zone mobile-slide-zone-prev"
                        type="button"
                        data-mobile-slide-prev
                        aria-label="Previous image"
                      ></button>

                      <button
                        class="mobile-slide-zone mobile-slide-zone-next"
                        type="button"
                        data-mobile-slide-next
                        aria-label="Next image"
                      ></button>
                    </div>
                  )
                }

                if (mobileImages.length === 1) {
                  return (
                    <div class="mobile-media-item">
                      <img
                        src={sanityImage(mobileImages[0].url, 1024)}
                        srcset={sanitySrcset(mobileImages[0].url)}
                        sizes="100vw"
                        width={mobileImages[0].width}
                        height={mobileImages[0].height}
                        alt={mobileImages[0].alt}
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  )
                }

                return null
              })}
            </div>

            <div class="meta">
              <p>Brand: {project.brand}</p>
              <p>Project: {project.projectName}</p>
              <p class="secondary-meta">Role: {project.role}</p>
              <p class="secondary-meta">Agency: {project.agency}</p>
            </div>

            <div class="description" data-project-description>
              <div
                class="description-version short-description"
                data-short-description
              >
                {project.description?.map((block) =>
                  block._type === 'block' ? (
                    <p>
                      {block.children?.map((child) => {
                        const link = block.markDefs?.find(
                          (mark) =>
                            mark._type === 'link' &&
                            child.marks?.includes(mark._key)
                        )

                        if (link?.project?.slug) {
                          return (
                            <a
                              href={`#project-${link.project.slug}`}
                              data-project-link={link.project.slug}
                            >
                              {child.text}
                            </a>
                          )
                        }

                        return link?.href ? (
                          <a href={link.href}>{child.text}</a>
                        ) : (
                          child.text
                        )
                      })}
                    </p>
                  ) : null
                )}
              </div>

              {
                project.enableReadMore && project.longDescription?.length ? (
                  <>
                    <div
                      class="description-version long-description"
                      data-long-description
                      hidden
                    >
                      {project.longDescription.map((block) =>
                        block._type === 'block' ? (
                          <p>
                            {block.children?.map((child) => {
                              const link = block.markDefs?.find(
                                (mark) =>
                                  mark._type === 'link' &&
                                  child.marks?.includes(mark._key)
                              )

                              if (link?.project?.slug) {
                                return (
                                  <a
                                    href={`#project-${link.project.slug}`}
                                    data-project-link={link.project.slug}
                                  >
                                    {child.text}
                                  </a>
                                )
                              }

                              return link?.href ? (
                                <a href={link.href}>{child.text}</a>
                              ) : (
                                child.text
                              )
                            })}
                          </p>
                        ) : null
                      )}
                    </div>

                    <button
                      class="read-more"
                      type="button"
                      data-read-more
                      aria-expanded="false"
                    >
                      Read more
                    </button>
                  </>
                ) : null
              }
            </div>
          </section>
        )
      })
    }
  </main>
</Layout>

<style>
  .project {
    padding: var(--project-top-space) var(--project-gutter) var(--project-bottom-space);
    scroll-margin-top: 0;
  }

h2 {
  width: 760px;
  max-width: 90%;
  margin: 0 auto var(--project-headline-bottom-space);

  font-family: var(--font-display);
  font-size: var(--project-headline-size);
  font-weight: 300;
  line-height: var(--project-headline-line-height);
  letter-spacing: var(--project-headline-letter-spacing);

  text-align: center;
  white-space: pre-line;
}

  .tags {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 28px;
  }

  .project-tag {
    padding: 10px 13px 8px;
    border: 1px solid #292929;
    border-radius: 4px;
    background: var(--near-black);
    font-family: 'Aeonik Fono', monospace;
    font-size: var(--project-tag-size);
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #aaa;
    cursor: pointer;
    transition: border-color 160ms ease, color 160ms ease, opacity 160ms ease;
  }

  .project-tag:hover,
  .project-tag:focus-visible,
  .project-tag[aria-pressed='true'] {
    border-color: #777;
    color: var(--white);
  }

  .project-tag:focus-visible {
    outline: none;
  }

  .tag-clear {
    display: none;
  }

  .project-tag[aria-pressed='true'] .tag-clear {
    display: inline;
  }

  .project {
    transition: opacity 180ms ease;
  }

  .project.is-filtering-out {
    opacity: 0;
  }

  .project[hidden] {
    display: none;
  }

  /*
    Strong Cargo-style scroll reveal.
    Projects start visually black/invisible and slide upward into place.
  */
  .project[data-reveal-ready] > * {
    opacity: 0;
    transform: translateY(var(--reveal-distance));
    transition:
      opacity var(--reveal-opacity-duration) var(--reveal-ease),
      transform var(--reveal-duration) var(--reveal-ease);
    will-change: opacity, transform;
  }

  .project[data-reveal-ready].is-revealed > * {
    opacity: 1;
    transform: translateY(0);
  }

  /* A small stagger makes the arrival feel more designed */
  .project[data-reveal-ready].is-revealed > :nth-child(2) {
    transition-delay: 60ms;
  }

  .project[data-reveal-ready].is-revealed > :nth-child(3) {
    transition-delay: 120ms;
  }

  .project[data-reveal-ready].is-revealed > :nth-child(4) {
    transition-delay: 180ms;
  }

  .project[data-reveal-ready].is-revealed > :nth-child(n + 5) {
    transition-delay: 240ms;
  }

  .media-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--project-media-gap);
  }

  .mobile-media {
    display: none;
  }

  .media-item.full {
    grid-column: 1 / -1;
  }

  .media-item.half {
    grid-column: span 1;
  }

  .media-item > img,
  .media-item > video {
    display: block;
    width: 100%;
    height: auto;
  }

  .project-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: var(--project-media-gap);
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .project-gallery img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-slideshow {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .slideshow-viewport {
    width: 100%;
    overflow: hidden;
  }

  .slideshow-track {
    display: flex;
    width: 100%;
    transition: transform 500ms cubic-bezier(.76, 0, .24, 1);
    will-change: transform;
  }

  .slideshow-slide {
    flex: 0 0 100%;
    width: 100%;
  }

  .slideshow-slide img {
    display: block;
    width: 100%;
    height: auto;
  }

  .slideshow-control {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 2;
    width: 50%;
    padding: 0;
    border: 0;
    background: transparent;
    color: white;
    cursor: pointer;
  }

  .slideshow-control-prev {
    left: 0;
  }

  .slideshow-control-next {
    right: 0;
  }

  .slideshow-control span {
    position: absolute;
    top: 50%;
    font-family: 'Aeonik Fono', monospace;
    font-size: 26px;
    line-height: 1;
    opacity: 0;
    transform: translateY(-50%);
    transition: opacity 150ms ease;
  }

  .slideshow-control-prev span {
    left: 22px;
  }

  .slideshow-control-next span {
    right: 22px;
  }

  .slideshow-control:hover span,
  .slideshow-control:focus-visible span {
    opacity: 1;
  }

  .slideshow-control:focus-visible {
    outline: none;
  }

.meta {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--project-media-gap);
  margin-top: var(--project-meta-top-space);

  font-size: var(--project-meta-size);
  line-height: var(--project-meta-line-height);
  color: var(--project-meta-color);
}

  .meta p {
    margin: 0;
  }

  .description {
    width: min(640px, 100%);
    margin: 58px auto 0;
   font-size: var(--project-body-size);
line-height: var(--project-body-line-height);
    color: #888;
  }

.description p {
  margin: 0 0 18px;
  text-indent: 2em;
}

.description a,
.description a:visited {
  color: #00ff1a;
  text-decoration: none;
}

.description a:hover,
.description a:focus-visible {
  color: #00ff1a;
  text-decoration: none;
}



  .read-more {
    margin: 12px 0 0;
    padding: 0;
    border: 0;
    background: transparent;
    font-family: 'Aeonik Fono', monospace;
    font-size: inherit;
    color: #888;
    cursor: pointer;
  }

  .read-more:hover {
    color: white;
  }


  /* Video media */
  .custom-video-player,
  .film-video {
    position: relative;
    width: 100%;
    background: var(--black);
  }

  .custom-video-player {
    overflow: hidden;
  }

.film-video {
  position: relative;
  overflow: hidden;
}

  .custom-video-player video,
  .film-video video {
    display: block;
    width: 100%;
    height: auto;
  }

  .film-video video {
    cursor: pointer;
    border-radius: 0;
  }

  .loop-video video {
    pointer-events: none;
  }

  /*
    Film controls sit over the bottom of the video.
  */
  .film-controls {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;

  display: grid;
  grid-template-columns: auto minmax(70px, 1fr) auto auto;
  align-items: center;
  gap: 12px;

  padding: 18px 12px 10px;

  background: linear-gradient(
    to top,
    rgba(0, 0, 0, 0.8),
    transparent
  );

  color: var(--white);
  font-size: 9px;
  line-height: 1;
  letter-spacing: 0.08em;

  opacity: 0.7;
  transition: opacity 160ms ease;
}

.film-video:hover .film-controls,
.film-video:focus-within .film-controls {
  opacity: 1;
}

.film-control {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  letter-spacing: inherit;
  cursor: pointer;
  white-space: nowrap;
}

.film-control:hover,
.film-control:focus-visible {
  color: #999;
}

.film-control:focus-visible,
.film-progress:focus-visible {
  outline: 1px solid currentColor;
  outline-offset: 4px;
}

.film-time {
  white-space: nowrap;
  color: #aaa;
}

.film-progress {
  --film-progress: 0%;

  width: 100%;
  height: 12px;
  margin: 0;

  border: 0;
  background: linear-gradient(
    to right,
    var(--white) 0%,
    var(--white) var(--film-progress),
    #444 var(--film-progress),
    #444 100%
  );
  background-size: 100% 1px;
  background-position: center;
  background-repeat: no-repeat;

  cursor: pointer;
  appearance: none;
  -webkit-appearance: none;
}

.film-progress::-webkit-slider-runnable-track {
  height: 12px;
  background: transparent;
}

.film-progress::-webkit-slider-thumb {
  width: 8px;
  height: 8px;
  margin-top: 2px;
  border: 0;
  border-radius: 50%;
  background: var(--white);
  appearance: none;
  -webkit-appearance: none;
}

.film-progress::-moz-range-track {
  height: 1px;
  background: transparent;
}

.film-progress::-moz-range-progress {
  height: 1px;
  background: var(--white);
}

.film-progress::-moz-range-thumb {
  width: 8px;
  height: 8px;
  border: 0;
  border-radius: 50%;
  background: var(--white);
}



  @media (max-width: 700px) {
    .film-controls {
      grid-template-columns: auto minmax(50px, 1fr) auto;
      gap: 9px;
      padding: 10px;
      font-size: 8px;
    }

    .film-time {
      display: none;
    }
  }

  @media (max-width: 700px) {
    .project {
      padding: var(--project-top-space-mobile) var(--project-gutter-mobile) var(--project-bottom-space-mobile);
    }

h2 {
      width: 100%;
      max-width: 100%;
      margin: 0 auto var(--project-headline-bottom-space);
      font-size: var(--project-headline-size-mobile);
      line-height: var(--project-headline-line-height);
      letter-spacing: var(--project-headline-letter-spacing);
      text-align: center;
      white-space: pre-line;
    }

    .tags {
      gap: 7px;
      margin-bottom: 22px;
    }

    .project-tag {
      padding: 8px 10px 7px;
      font-size: var(--project-tag-size-mobile);
    }

    .desktop-media {
      display: none;
    }

    .mobile-media {
      display: flex;
      flex-direction: column;
      gap: 12px;
      width: calc(100% + (var(--project-gutter-mobile) * 2));
      margin-left: calc(var(--project-gutter-mobile) * -1);
      margin-right: calc(var(--project-gutter-mobile) * -1);
    }

    .mobile-media-item,
    .mobile-media-item > img {
      display: block;
      width: 100%;
    }

    .mobile-media-item > img {
