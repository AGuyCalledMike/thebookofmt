---
import '../styles/global.css'

import Header from '../components/Header.astro'
import InfoOverlay from '../components/InfoOverlay.astro'
import Playground from '../components/Playground.astro'
import Footer from '../components/Footer.astro'

interface Props {
  title?: string
}

const {
  title = 'The Book of MT'
} = Astro.props
---

<!doctype html>

<html lang="en" class="view-home">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="robots"
      content="noindex, nofollow"
    />

    <title>{title}</title>
  </head>

  <body id="top">
    <Header />

    <div class="site-viewport">
      <div class="site-track" data-site-track>

        <section class="site-panel info-view" data-view="info">
          <InfoOverlay />
          <Footer />
        </section>

        <section
          class="site-panel projects-view"
          data-view="home"
          data-scroll-panel
        >
          <slot />
          <Footer />
        </section>

        <section
          class="site-panel playground-view"
          data-view="playground"
          data-scroll-panel
        >
          <Playground />
          <Footer />
        </section>

      </div>
    </div>
  </body>
</html>
