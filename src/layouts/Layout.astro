---
import Header from '../components/Header.astro'
import InfoOverlay from '../components/InfoOverlay.astro'
import Playground from '../components/Playground.astro'

interface Props {
  title?: string
}

const {
  title = 'The Book of MT'
} = Astro.props
---

<!doctype html>

<html lang="en" class="view-home">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="robots"
      content="noindex, nofollow"
    />

    <title>{title}</title>
  </head>

  <body id="top">
    <Header />

    <div class="site-viewport">
      <div class="site-track" data-site-track>

        <section class="site-panel info-view" data-view="info">
          <InfoOverlay />
        </section>

        <section
          class="site-panel projects-view"
          data-view="home"
          data-scroll-panel
        >
          <slot />
        </section>

 <section
  class="site-panel playground-view"
  data-view="playground"
  data-scroll-panel
>
  <Playground />
</section>

      </div>
    </div>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Aeonik Fono';
    src: url('/fonts/AeonikFono-Regular.woff') format('woff');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Aeonik Fono';
    src: url('/fonts/AeonikFono-Bold.woff') format('woff');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Cooper';
    src: url('/fonts/Cooper_Light.woff2') format('woff2');
    font-weight: 300;
    font-style: normal;
    font-display: swap;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: #000;
    color: #fff;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Aeonik Fono', monospace;
  }

  button,
  input,
  textarea,
  select {
    font: inherit;
  }

  .site-viewport {
    width: 100vw;
    height: 100vh;
    overflow: hidden;
  }

  .site-track {
    display: flex;
    width: 300vw;
    height: 100%;
    transform: translateX(-100vw);
    transition: transform 650ms cubic-bezier(0.76, 0, 0.24, 1);
  }

  .site-panel {
    flex: 0 0 100vw;
    width: 100vw;
    height: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
  }

  .info-view {
    background: #f3efe6;
    color: #111;
  }

  .projects-view {
    background: #000;
    color: #fff;
  }

  .playground-view {
    background: #111;
    color: #fff;
  }

  html.view-info .site-track {
    transform: translateX(0);
  }

  html.view-home .site-track {
    transform: translateX(-100vw);
  }

  html.view-playground .site-track {
    transform: translateX(-200vw);
  }



  @media (max-width: 700px) {
    .playground-placeholder {
      padding: 120px 20px;
      font-size: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-track {
      transition: none;
    }
  }
</style>
