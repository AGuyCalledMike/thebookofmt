---
const year = new Date().getFullYear()
---

<footer class="site-footer">
  <div class="footer-meta">
    <span>© {year} Michael Thomason</span>

    <div class="footer-end" aria-hidden="true">
      <video
        class="footer-end-video footer-end-home"
        muted
        loop
        playsinline
        preload="none"
      >
        <source src="/the-end-home.mp4" type="video/mp4" />
      </video>

      <video
        class="footer-end-video footer-end-info"
        muted
        loop
        playsinline
        preload="none"
      >
        <source src="/the-end-info.mp4" type="video/mp4" />
      </video>
    </div>

    <div class="footer-links">
      <a href="mailto:michaelthomason@me.com">Email</a>
      <a
        href="https://www.linkedin.com/"
        target="_blank"
        rel="noreferrer"
      >
        LinkedIn
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    padding:
      var(--footer-top-space)
      var(--footer-gutter)
      var(--footer-bottom-space);
    color: #888;
  }

  .footer-meta {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: 24px;

    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-end {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 90px;
    transform: translate(-50%, -50%);
  }

  .footer-end-video {
    display: block;
    width: 100%;
    height: auto;
  }

  .footer-end-info {
    display: none;
  }

  :global(html.view-info) .footer-end-home {
    display: none;
  }

  :global(html.view-info) .footer-end-info {
    display: block;
  }

  .footer-links {
    display: flex;
    gap: 18px;
  }

  .footer-links a {
    color: inherit;
    text-decoration: none;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 700px) {
    .site-footer {
      padding:
        var(--footer-top-space-mobile)
        var(--footer-gutter-mobile)
        var(--footer-bottom-space-mobile);
    }

    .footer-meta > span,
    .footer-links {
      display: none;
    }
  }
</style>

<script>
  const footerVideos = document.querySelectorAll('.footer-end-video')

  const footerVideoObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const video = entry.target

        if (!(video instanceof HTMLVideoElement)) return

        if (entry.isIntersecting) {
          video.preload = 'auto'
          video.load()

          const playPromise = video.play()

          if (playPromise instanceof Promise) {
            playPromise.catch(() => {})
          }
        } else if (!video.paused) {
          video.pause()
        }
      })
    },
    {
      rootMargin: '300px 0px',
      threshold: 0.01,
    }
  )

  footerVideos.forEach((video) => {
    footerVideoObserver.observe(video)
  })
</script>