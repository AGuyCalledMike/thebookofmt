---
import { sanityClient } from 'sanity:client'

const settings = await sanityClient.fetch(`
  *[_type == "siteSettings"][0] {
    email
  }
`)
---

<header class="site-header">
  <button class="eyes" type="button" data-view-trigger="home" aria-label="Home">
    <span class="eye">
      <span class="pupil"></span>
    </span>
    <span class="eye">
      <span class="pupil"></span>
    </span>
  </button>

  <button type="button" data-view-trigger="home">Home</button>
  <button type="button" data-view-trigger="info">Info</button>
  <button type="button" data-view-trigger="playground">Playground</button>

  <button class="contact" type="button" data-email={settings?.email}>
    Contact
  </button>

  <button class="back-to-top" type="button">Back to Top</button>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1000;

    display: grid;
    grid-template-columns: auto repeat(5, 1fr);
    align-items: center;

    width: 100%;
    padding: 30px 36px;

    font-family: 'Aeonik Fono', monospace;
    font-size: 12px;

    pointer-events: none;
  }

  .site-header button {
    padding: 0;
    border: 0;
    background: transparent;
    color: #888;
    font: inherit;
    text-decoration: none;
    cursor: pointer;
    pointer-events: auto;
    transition: color 150ms ease;
  }

  .site-header > button:not(.eyes) {
    justify-self: center;
  }

  .site-header button:hover {
    color: white;
  }

  :global(html.view-info) .site-header button {
    color: #111;
  }

  :global(html.view-info) .site-header button:hover {
    color: #777;
  }

  .eyes {
    display: flex;
    gap: 6px;
    justify-self: start;
  }

  .eye {
    position: relative;
    display: block;
    width: 19px;
    height: 24px;
    border: 1px solid #000;
    border-radius: 50%;
    background: #fff;
  }

  .pupil {
    position: absolute;
    top: 8px;
    left: 6px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #000;
    transform: translate(0, 0);
  }

  @media (max-width: 700px) {
  .site-header {
  grid-template-columns: auto 1fr 1fr 1fr;
  gap: 14px;
  padding: 20px;
  font-size: 12px;
}

    .site-header > :nth-child(5),
    .site-header > :nth-child(6) {
      display: none;
    }

    .eye {
      width: 16px;
      height: 20px;
    }

    .pupil {
      top: 7px;
      left: 5px;
      width: 6px;
      height: 6px;
      transform: translate(0, 0) !important;
    }

    .eye {
      transform-origin: center;
      transition: transform 90ms ease;
    }

    :global(html.eyes-blink) .eye {
      transform: scaleY(0.12);
    }
  }
</style>

<script>
  // Eyes follow the pointer on desktop only.
  // Touch/mobile devices keep the pupils centred.
  const eyes = document.querySelectorAll('.eye')
  const mobileEyes = window.matchMedia(
    '(max-width: 700px), (hover: none), (pointer: coarse)'
  )

  const centreEyes = () => {
    eyes.forEach((eye) => {
      const pupil = eye.querySelector('.pupil')
      if (!(pupil instanceof HTMLElement)) return
      pupil.style.transform = 'translate(0, 0)'
    })
  }

  window.addEventListener('pointermove', (event) => {
    if (mobileEyes.matches) {
      centreEyes()
      return
    }

    eyes.forEach((eye) => {
      const pupil = eye.querySelector('.pupil')
      if (!(pupil instanceof HTMLElement)) return

      const rect = eye.getBoundingClientRect()
      const eyeX = rect.left + rect.width / 2
      const eyeY = rect.top + rect.height / 2
      const angle = Math.atan2(event.clientY - eyeY, event.clientX - eyeX)
      const distance = 3.5

      pupil.style.transform = `translate(${Math.cos(angle) * distance}px, ${Math.sin(angle) * distance}px)`
    })
  })

  mobileEyes.addEventListener?.('change', () => {
    if (mobileEyes.matches) centreEyes()
  })

  if (mobileEyes.matches) centreEyes()

  // On mobile, blink occasionally while the site's scroll panels move.
  // The page itself does not scroll; Home, Info and Playground scroll independently.
  let blinkCooldown = false
  let blinkTimeout = null

  const triggerMobileBlink = () => {
    if (!mobileEyes.matches || blinkCooldown) return

    blinkCooldown = true
    document.documentElement.classList.add('eyes-blink')

    window.setTimeout(() => {
      document.documentElement.classList.remove('eyes-blink')
    }, 130)

    // Slightly random delay keeps it from feeling mechanical.
    blinkTimeout = window.setTimeout(() => {
      blinkCooldown = false
      blinkTimeout = null
    }, 500 + Math.random() * 450)
  }

  const scrollTargets = [
    ...document.querySelectorAll('[data-scroll-panel]'),
    ...document.querySelectorAll('.info-view'),
    ...document.querySelectorAll('[data-view="home"]'),
    ...document.querySelectorAll('[data-view="playground"]'),
  ]

  // Remove duplicates, then listen to the elements that actually scroll.
  ;[...new Set(scrollTargets)].forEach((target) => {
    target.addEventListener('scroll', triggerMobileBlink, {passive: true})
  })

  // Fallback for any browser/layout where the document itself becomes scrollable.
  window.addEventListener('scroll', triggerMobileBlink, {passive: true})

  mobileEyes.addEventListener?.('change', () => {
    if (!mobileEyes.matches) {
      document.documentElement.classList.remove('eyes-blink')
      blinkCooldown = false

      if (blinkTimeout) {
        window.clearTimeout(blinkTimeout)
        blinkTimeout = null
      }
    } else {
      centreEyes()
    }
  })

  // Contact copies email
  const contactButton = document.querySelector('.contact')

  contactButton?.addEventListener('click', async () => {
    if (!(contactButton instanceof HTMLElement)) return

    const email = contactButton.dataset.email
    if (!email) return

    try {
      await navigator.clipboard.writeText(email)
      const originalText = contactButton.textContent
      contactButton.textContent = 'Copied'

      window.setTimeout(() => {
        contactButton.textContent = originalText
      }, 1200)
    } catch {
      console.error('Could not copy email address.')
    }
  })

  // Three-panel navigation
  const viewTriggers = document.querySelectorAll('[data-view-trigger]')

  function showView(view) {
    document.documentElement.classList.remove(
      'view-info',
      'view-home',
      'view-playground'
    )

    document.documentElement.classList.add(`view-${view}`)
  }

  viewTriggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      if (!(trigger instanceof HTMLElement)) return
      const view = trigger.dataset.viewTrigger
      if (!view) return
      showView(view)
    })
  })

  // Escape returns to Projects
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return

    if (
      document.documentElement.classList.contains('view-info') ||
      document.documentElement.classList.contains('view-playground')
    ) {
      showView('home')
    }
  })

  // Back to top applies to the currently visible panel
  const backToTop = document.querySelector('.back-to-top')

  backToTop?.addEventListener('click', () => {
    let selector = '[data-scroll-panel="home"]'

    if (document.documentElement.classList.contains('view-playground')) {
      selector = '[data-scroll-panel="playground"]'
    } else if (document.documentElement.classList.contains('view-info')) {
      selector = '.info-view'
    }

    const panel = document.querySelector(selector)
    panel?.scrollTo({ top: 0, behavior: 'smooth' })
  })
</script>
