---
import { sanityClient } from 'sanity:client'

const settings = await sanityClient.fetch(`
  *[_type == "siteSettings"][0] {
    email
  }
`)
---

<header class="site-header">
  <button class="eyes" type="button" data-view-trigger="home" aria-label="Home">
    <span class="eye">
      <span class="pupil"></span>
    </span>
    <span class="eye">
      <span class="pupil"></span>
    </span>
  </button>

  <button type="button" data-view-trigger="home">Home</button>
  <button type="button" data-view-trigger="info">Info</button>
  <button type="button" data-view-trigger="playground">Playground</button>

  <button class="contact" type="button" data-email={settings?.email}>
    Contact
  </button>

  <button class="back-to-top" type="button">Back to Top</button>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1000;

    display: grid;
    grid-template-columns: auto repeat(5, 1fr);
    align-items: center;

    width: 100%;
    padding: 30px 36px;

    font-family: 'Aeonik Fono', monospace;
    font-size: 12px;

    pointer-events: none;
  }

  .site-header button {
    padding: 0;
    border: 0;
    background: transparent;
    color: #888;
    font: inherit;
    text-decoration: none;
    cursor: pointer;
    pointer-events: auto;
    transition: color 150ms ease;
  }

  .site-header > button:not(.eyes) {
    justify-self: center;
  }

  .site-header button:hover {
    color: white;
  }

  :global(html.view-info) .site-header button {
    color: #111;
  }

  :global(html.view-info) .site-header button:hover {
    color: #777;
  }

  .eyes {
    display: flex;
    gap: 6px;
    justify-self: start;
  }

  .eye {
    position: relative;
    display: block;
    width: 19px;
    height: 24px;
    border: 1px solid #000;
    border-radius: 50%;
    background: #fff;
  }

  .pupil {
    position: absolute;
    top: 8px;
    left: 6px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #000;
    transform: translate(0, 0);
  }

  :global(.copy-confetti) {
    position: fixed;
    z-index: 9999;
    width: 5px;
    height: 8px;
    pointer-events: none;
    animation: copy-confetti-burst 600ms ease-out forwards;
  }

  @keyframes copy-confetti-burst {
    from {
      transform: translate(-50%, -50%) rotate(0deg);
      opacity: 1;
    }

    to {
      transform:
        translate(
          calc(-50% + var(--x)),
          calc(-50% + var(--y))
        )
        rotate(var(--r));
      opacity: 0;
    }
  }

  @media (max-width: 700px) {
    .site-header {
      grid-template-columns: auto 1fr 1fr 1fr 1fr;
      gap: 14px;
      padding: 20px;
      font-size: 12px;
    }

    .site-header > :nth-child(6) {
      display: none;
    }

    .eye {
      width: 16px;
      height: 20px;
      transform-origin: center;
      transition: transform 90ms ease;
    }

    .pupil {
      top: 7px;
      left: 5px;
      width: 6px;
      height: 6px;
      transform: translate(0, 0) !important;
    }

    :global(html.eyes-blink) .eye {
      transform: scaleY(0.12);
    }
  }
</style>

<script>
  const eyes = document.querySelectorAll('.eye')

  const mobileEyes = window.matchMedia(
    '(max-width: 700px), (hover: none), (pointer: coarse)'
  )

  const centreEyes = () => {
    eyes.forEach((eye) => {
      const pupil = eye.querySelector('.pupil')
      if (!(pupil instanceof HTMLElement)) return
      pupil.style.transform = 'translate(0, 0)'
    })
  }

  window.addEventListener('pointermove', (event) => {
    if (mobileEyes.matches) {
      centreEyes()
      return
    }

    eyes.forEach((eye) => {
      const pupil = eye.querySelector('.pupil')
      if (!(pupil instanceof HTMLElement)) return

      const rect = eye.getBoundingClientRect()
      const eyeX = rect.left + rect.width / 2
      const eyeY = rect.top + rect.height / 2

      const angle = Math.atan2(
        event.clientY - eyeY,
        event.clientX - eyeX
      )

      const distance = 3.5

      pupil.style.transform = `translate(
        ${Math.cos(angle) * distance}px,
        ${Math.sin(angle) * distance}px
      )`
    })
  })

  mobileEyes.addEventListener?.('change', () => {
    if (mobileEyes.matches) {
      centreEyes()
    }
  })

  if (mobileEyes.matches) {
    centreEyes()
  }

  let blinkCooldown = false
  let blinkTimeout = null

  const triggerMobileBlink = () => {
    if (!mobileEyes.matches || blinkCooldown) return

    blinkCooldown = true
    document.documentElement.classList.add('eyes-blink')

    window.setTimeout(() => {
      document.documentElement.classList.remove('eyes-blink')
    }, 130)

    blinkTimeout = window.setTimeout(() => {
      blinkCooldown = false
      blinkTimeout = null
    }, 500 + Math.random() * 450)
  }

  const scrollTargets = [
    ...document.querySelectorAll('[data-scroll-panel]'),
    ...document.querySelectorAll('.info-view'),
  ]

  ;[...new Set(scrollTargets)].forEach((target) => {
    target.addEventListener('scroll', triggerMobileBlink, {
      passive: true,
    })
  })

  window.addEventListener('scroll', triggerMobileBlink, {
    passive: true,
  })

  mobileEyes.addEventListener?.('change', () => {
    if (!mobileEyes.matches) {
      document.documentElement.classList.remove('eyes-blink')
      blinkCooldown = false

      if (blinkTimeout) {
        window.clearTimeout(blinkTimeout)
        blinkTimeout = null
      }
    } else {
      centreEyes()
    }
  })

  const burstConfetti = (element) => {
    if (!(element instanceof HTMLElement)) return

    const rect = element.getBoundingClientRect()
    const colour = window.getComputedStyle(element).color

    for (let i = 0; i < 14; i++) {
      const piece = document.createElement('span')
      piece.className = 'copy-confetti'

      const angle = Math.random() * Math.PI * 2
      const distance = 25 + Math.random() * 35

      piece.style.left = `${rect.left + rect.width / 2}px`
      piece.style.top = `${rect.top + rect.height / 2}px`
      piece.style.background = colour

      piece.style.setProperty(
        '--x',
        `${Math.cos(angle) * distance}px`
      )

      piece.style.setProperty(
        '--y',
        `${Math.sin(angle) * distance}px`
      )

      piece.style.setProperty(
        '--r',
        `${Math.random() * 360}deg`
      )

      document.body.appendChild(piece)

      piece.addEventListener('animationend', () => {
        piece.remove()
      })
    }
  }

  const copyEmail = async (email) => {
  try {
    if (navigator.clipboard && window.isSecureContext) {
      await navigator.clipboard.writeText(email)
      return true
    }
  } catch {
    // Fall through to Safari/legacy fallback
  }

  const textarea = document.createElement('textarea')

  textarea.value = email
  textarea.setAttribute('readonly', '')
  textarea.style.position = 'fixed'
  textarea.style.opacity = '0'
  textarea.style.pointerEvents = 'none'

  document.body.appendChild(textarea)

  textarea.focus()
  textarea.select()
  textarea.setSelectionRange(0, email.length)

  let copied = false

  try {
    copied = document.execCommand('copy')
  } catch {
    copied = false
  }

  textarea.remove()

  return copied
}

const contactButton = document.querySelector('.contact')

contactButton?.addEventListener('click', async () => {
  if (!(contactButton instanceof HTMLElement)) return

  const email = contactButton.dataset.email
  if (!email) return

  const copied = await copyEmail(email)

  if (!copied) {
    console.error('Could not copy email address.')
    return
  }

  const originalText = contactButton.textContent

  contactButton.textContent = 'Email copied'

  burstConfetti(contactButton)

  window.setTimeout(() => {
    contactButton.textContent = originalText
  }, 1200)
})

</script>