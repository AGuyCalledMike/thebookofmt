---
import { sanityClient } from 'sanity:client'

const settings = await sanityClient.fetch(`
  *[_type == "siteSettings"][0] {
    email
  }
`)
---

<header class="site-header">
  <button class="eyes" type="button" data-view-trigger="home" aria-label="Home">
    <span class="eye">
      <span class="pupil"></span>
    </span>
    <span class="eye">
      <span class="pupil"></span>
    </span>
  </button>

  <button type="button" data-view-trigger="home">Home</button>
  <button type="button" data-view-trigger="info">Info</button>
  <button type="button" data-view-trigger="playground">Playground</button>

  <button class="contact" type="button" data-email={settings?.email}>
    Contact
  </button>

  <button class="back-to-top" type="button">Back to Top</button>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1000;

    display: grid;
    grid-template-columns: auto repeat(5, 1fr);
    align-items: center;

    width: 100%;
    padding: 30px 36px;

    font-family: 'Aeonik Fono', monospace;
    font-size: 12px;

    pointer-events: none;
  }

  .site-header button {
    padding: 0;
    border: 0;
    background: transparent;

    color: #888;
    font: inherit;
    text-decoration: none;

    cursor: pointer;
    pointer-events: auto;

    transition: color 150ms ease;
  }

  .site-header > button:not(.eyes) {
    position: relative;
    justify-self: center;
  }

  .site-header > button:not(.eyes)::after {
    content: '';

    position: absolute;
    left: 0;
    bottom: -4px;

    width: 100%;
    height: 1px;

    background: currentColor;

    transform: scaleX(0);
    transform-origin: left;

    transition: transform 220ms ease;
  }

  .site-header > button:not(.eyes):hover::after {
    transform: scaleX(1);
  }

  .site-header button:hover {
    color: white;
  }

  :global(html.view-home)
    .site-header > button[data-view-trigger="home"]:not(.eyes)::after,

  :global(html.view-info)
    .site-header > button[data-view-trigger="info"]::after,

  :global(html.view-playground)
    .site-header > button[data-view-trigger="playground"]::after {
    transform: scaleX(1);
  }

  :global(html.view-info) .site-header button {
    color: #111;
  }

  :global(html.view-info) .site-header button:hover {
    color: #777;
  }

  .eyes {
    display: flex;
    gap: 6px;
    justify-self: start;
  }

  .eye {
    position: relative;
    display: block;

    width: 19px;
    height: 24px;

    border: 1px solid #000;
    border-radius: 50%;

    background: #fff;
  }

  .pupil {
    position: absolute;
    top: 8px;
    left: 6px;

    width: 7px;
    height: 7px;

    border-radius: 50%;
    background: #000;

    transform: translate(0, 0);
  }

  @media (max-width: 700px) {
    .site-header {
      grid-template-columns: auto 1fr 1fr 1fr;
      gap: 14px;
      padding: 20px;
      font-size: 10px;
    }

    .site-header > :nth-child(5),
    .site-header > :nth-child(6) {
      display: none;
    }

    .eye {
      width: 16px;
      height: 20px;
    }

    .pupil {
      top: 7px;
      left: 5px;
      width: 6px;
      height: 6px;
    }
  }
</style>

<script>
  // Eyes follow cursor
  const eyes = document.querySelectorAll('.eye')

  window.addEventListener('pointermove', (event) => {
    eyes.forEach((eye) => {
      const pupil = eye.querySelector('.pupil')
      if (!(pupil instanceof HTMLElement)) return

      const rect = eye.getBoundingClientRect()
      const eyeX = rect.left + rect.width / 2
      const eyeY = rect.top + rect.height / 2

      const angle = Math.atan2(
        event.clientY - eyeY,
        event.clientX - eyeX
      )

      const distance = 3.5

      const x = Math.cos(angle) * distance
      const y = Math.sin(angle) * distance

      pupil.style.transform = `translate(${x}px, ${y}px)`
    })
  })

  // Contact copies email
  const contactButton = document.querySelector('.contact')

  contactButton?.addEventListener('click', async () => {
    if (!(contactButton instanceof HTMLElement)) return

    const email = contactButton.dataset.email
    if (!email) return

    try {
      await navigator.clipboard.writeText(email)

      const originalText = contactButton.textContent
      contactButton.textContent = 'Copied'

      window.setTimeout(() => {
        contactButton.textContent = originalText
      }, 1200)
    } catch {
      console.error('Could not copy email address.')
    }
  })

  // Three-panel navigation
  const viewTriggers = document.querySelectorAll('[data-view-trigger]')

  function showView(view) {
    document.documentElement.classList.remove(
      'view-info',
      'view-home',
      'view-playground'
    )

    document.documentElement.classList.add(`view-${view}`)
  }

  viewTriggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      if (!(trigger instanceof HTMLElement)) return

      const view = trigger.dataset.viewTrigger
      if (!view) return

      showView(view)
    })
  })

  // Escape returns to Projects
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return

    if (
      document.documentElement.classList.contains('view-info') ||
      document.documentElement.classList.contains('view-playground')
    ) {
      showView('home')
    }
  })

  // Back to top applies to the currently visible panel
  const backToTop = document.querySelector('.back-to-top')

  backToTop?.addEventListener('click', () => {
    let selector = '[data-view="home"]'

    if (document.documentElement.classList.contains('view-playground')) {
      selector = '[data-view="playground"]'
    } else if (document.documentElement.classList.contains('view-info')) {
      selector = '[data-view="info"]'
    }

    const panel = document.querySelector(selector)

    if (panel instanceof HTMLElement) {
      panel.scrollTo({
        top: 0,
        behavior: 'smooth',
      })
    }
  })
</script>
