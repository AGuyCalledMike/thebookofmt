---
import { sanityClient } from 'sanity:client'

const imageWidths = [320, 480, 640, 800, 1024, 1280]

function sanityImage(url, width) {
  if (!url) return undefined

  const separator = url.includes('?') ? '&' : '?'

  return `${url}${separator}auto=format&fit=max&w=${width}&q=82`
}

function sanitySrcset(url) {
  if (!url) return undefined

  return imageWidths
    .map((width) => `${sanityImage(url, width)} ${width}w`)
    .join(', ')
}

const playground = await sanityClient.fetch(`
  *[_type == "playground"][0] {
    images[] {
      _key,
      alt,
      hidden,
      asset-> {
        url,
        originalFilename,
        metadata {
          dimensions {
            width,
            height,
            aspectRatio
          }
        }
      }
    },

    videos[] {
      _key,
      hidden,
      asset-> {
        url,
        originalFilename
      }
    }
  }
`)

const images = playground?.images?.filter((item) => !item.hidden) ?? []
const videos = playground?.videos?.filter((item) => !item.hidden) ?? []
---

<div class="playground-panel">
  {
    images.length ? (
      <div class="playground-masonry">
        {images.map((item) => (
          <figure class="playground-item">
            <img
              class="image-reveal"
              src={sanityImage(item.asset?.url, 800)}
              srcset={sanitySrcset(item.asset?.url)}
              sizes="(max-width: 700px) 50vw, (max-width: 900px) 50vw, 25vw"
              width={item.asset?.metadata?.dimensions?.width}
              height={item.asset?.metadata?.dimensions?.height}
              alt={item.alt || item.asset?.originalFilename || ''}
              loading="lazy"
              decoding="async"
            />
          </figure>
        ))}
      </div>
    ) : null
  }

  {
    videos.length ? (
      <div class="playground-masonry playground-videos">
        {videos.map((item) => (
          <figure class="playground-item">
            <video class="image-reveal" autoplay muted loop playsinline preload="metadata">
              <source src={item.asset?.url} />
            </video>
          </figure>
        ))}
      </div>
    ) : null
  }
</div>

<style>
  .playground-panel {
    min-height: 100%;
    background: var(--black);
    color: var(--white);
  }

  .playground-masonry {
    columns: 4;
    column-gap: var(--playground-gap);

    padding:
      var(--playground-top-space)
      var(--playground-gutter)
      var(--playground-gutter);
  }

  .playground-videos {
    padding-top: 0;
  }

  .playground-item {
    display: inline-block;
    width: 100%;
    vertical-align: top;
    break-inside: avoid;
    break-inside: avoid-column;
    margin: 0 0 var(--playground-gap);
  }

  .playground-item img,
  .playground-item video {
    display: block;
    width: 100%;
    height: auto;
  }

  .image-reveal {
    opacity: 0;
    transform: translateY(var(--reveal-distance));
    transition:
      opacity var(--reveal-opacity-duration) var(--reveal-ease),
      transform var(--reveal-duration) var(--reveal-ease);
    will-change: opacity, transform;
  }

  .image-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .image-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .playground-masonry {
      columns: 2;
    }
  }

  @media (max-width: 700px) {
    .playground-masonry {
      columns: 2;
      column-gap: var(--playground-gap-mobile);
      padding:
        var(--playground-top-space-mobile)
        var(--playground-gutter-mobile)
        0;
    }

    .playground-videos {
      padding-top: 0;
    }

    .playground-item {
      margin-bottom: var(--playground-gap-mobile);
    }
  }
</style>

<script>
  // Fade/slide Playground media in whenever it enters the panel,
  // then reset it once it leaves so the reveal can play again.
  const revealMedia = document.querySelectorAll('.image-reveal')
  const playgroundPanel = document.querySelector('.playground-view')

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const media = entry.target

          if (!entry.isIntersecting) {
            media.classList.remove('is-visible')
            return
          }

          const reveal = () => {
            requestAnimationFrame(() => {
              media.classList.add('is-visible')
            })
          }

          if (media instanceof HTMLImageElement && !media.complete) {
            media.addEventListener('load', reveal, {once: true})
          } else {
            reveal()
          }
        })
      },
      {
        root: playgroundPanel instanceof Element ? playgroundPanel : null,
        rootMargin: '0px 0px 8% 0px',
        threshold: 0.04,
      }
    )

    revealMedia.forEach((media) => revealObserver.observe(media))
  }
</script>
