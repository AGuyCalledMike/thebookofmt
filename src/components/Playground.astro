---
import { sanityClient } from 'sanity:client'

const imageWidths = [320, 480, 640, 800, 1024, 1280]

function sanityImage(url, width) {
  if (!url) return undefined

  const separator = url.includes('?') ? '&' : '?'

  return `${url}${separator}auto=format&fit=max&w=${width}&q=82`
}

function sanitySrcset(url) {
  if (!url) return undefined

  return imageWidths
    .map((width) => `${sanityImage(url, width)} ${width}w`)
    .join(', ')
}

const playground = await sanityClient.fetch(`
  *[_type == "playground"][0] {
    items[] {
      _key,
      mediaType,
      videoMode,
      alt,
      hidden,

      image {
        asset-> {
          url,
          originalFilename,
          metadata {
            dimensions {
              width,
              height,
              aspectRatio
            }
          }
        }
      },

      video {
        asset-> {
          url,
          originalFilename
        }
      }
    },

    images[] {
      _key,
      alt,
      hidden,
      asset-> {
        url,
        originalFilename,
        metadata {
          dimensions {
            width,
            height,
            aspectRatio
          }
        }
      }
    },

    videos[] {
      _key,
      hidden,
      videoMode,
      asset-> {
        url,
        originalFilename
      }
    }
  }
`)

const mixedItems = playground?.items?.filter((item) => !item.hidden) ?? []

// Fallback keeps the current Playground visible until the new mixed feed is populated.
const legacyItems = mixedItems.length
  ? []
  : [
      ...(playground?.images ?? [])
        .filter((item) => !item.hidden)
        .map((item) => ({
          _key: item._key,
          mediaType: 'image',
          alt: item.alt,
          image: {
            asset: item.asset,
          },
        })),

      ...(playground?.videos ?? [])
        .filter((item) => !item.hidden)
        .map((item) => ({
          _key: item._key,
          mediaType: 'video',
          videoMode: item.videoMode || 'loop',
          video: {
            asset: item.asset,
          },
        })),
    ]

const items = mixedItems.length ? mixedItems : legacyItems
---

<div class="playground-panel">
  {
    items.length ? (
      <div class="playground-masonry">
        {items.map((item) => (
          <figure class="playground-item">
            {
              item.mediaType === 'video' && item.video?.asset?.url ? (
                item.videoMode === 'film' ? (
                  <video
                    class="image-reveal playground-film"
                    controls
                    playsinline
                    preload="metadata"
                  >
                    <source src={item.video.asset.url} />
                  </video>
                ) : (
                  <video
                    class="image-reveal playground-loop"
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                  >
                    <source src={item.video.asset.url} />
                  </video>
                )
              ) : item.image?.asset?.url ? (
                <img
                  class="image-reveal"
                  src={sanityImage(item.image.asset.url, 800)}
                  srcset={sanitySrcset(item.image.asset.url)}
                  sizes="(max-width: 700px) 50vw, (max-width: 900px) 50vw, 25vw"
                  width={item.image.asset.metadata?.dimensions?.width}
                  height={item.image.asset.metadata?.dimensions?.height}
                  alt={item.alt || item.image.asset.originalFilename || ''}
                  loading="lazy"
                  decoding="async"
                />
              ) : null
            }
          </figure>
        ))}
      </div>
    ) : null
  }
</div>

<style>
  .playground-panel {
    min-height: 100%;
    background: var(--black);
    color: var(--white);
  }

  .playground-masonry {
    columns: 4;
    column-gap: var(--playground-gap);

    padding:
      var(--playground-top-space)
      var(--playground-gutter)
      var(--playground-gutter);
  }

  .playground-item {
    display: inline-block;
    width: 100%;
    vertical-align: top;
    break-inside: avoid;
    break-inside: avoid-column;
    margin: 0 0 var(--playground-gap);
  }

  .playground-item img,
  .playground-item video {
    display: block;
    width: 100%;
    height: auto;
  }

  .playground-loop {
    pointer-events: none;
  }

  .image-reveal {
    opacity: 0;
    transform: translateY(var(--reveal-distance));
    transition:
      opacity var(--reveal-opacity-duration) var(--reveal-ease),
      transform var(--reveal-duration) var(--reveal-ease);
    will-change: opacity, transform;
  }

  .image-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .image-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .playground-masonry {
      columns: 2;
    }
  }

  @media (max-width: 700px) {
    .playground-masonry {
      columns: 2;
      column-gap: var(--playground-gap-mobile);
      padding:
        var(--playground-top-space-mobile)
        var(--playground-gutter-mobile)
        0;
    }

    .playground-item {
      margin-bottom: var(--playground-gap-mobile);
    }
  }
</style>

<script>
const revealMedia = document.querySelectorAll('.image-reveal')
const playgroundPanel = document.querySelector('.playground-view')

if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
  const revealObserver = new IntersectionObserver(
    (entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return

        const media = entry.target

        const reveal = () => {
          requestAnimationFrame(() => {
            media.classList.add('is-visible')
          })

          observer.unobserve(media)
        }

        if (media instanceof HTMLImageElement && !media.complete) {
          media.addEventListener('load', reveal, {once: true})
        } else {
          reveal()
        }
      })
    },
    {
      root: playgroundPanel instanceof Element ? playgroundPanel : null,
      rootMargin: '0px 0px 8% 0px',
      threshold: 0.04,
    }
  )

  revealMedia.forEach((media) => revealObserver.observe(media))
}

const playgroundLoops = document.querySelectorAll('.playground-loop')

const loopObserver = new IntersectionObserver(
  (entries) => {
    entries.forEach((entry) => {
      const video = entry.target
      if (!(video instanceof HTMLVideoElement)) return

      if (entry.isIntersecting) {
        const playPromise = video.play()

        if (playPromise instanceof Promise) {
          playPromise.catch(() => {})
        }
      } else if (!video.paused) {
        video.pause()
      }
    })
  },
  {
    root: playgroundPanel instanceof Element ? playgroundPanel : null,
    threshold: 0.05,
  }
)

playgroundLoops.forEach((video) => loopObserver.observe(video))
</script>
