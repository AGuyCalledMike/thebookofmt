---
import { sanityClient } from 'sanity:client'

const playground = await sanityClient.fetch(`
  *[_type == "playground"][0] {
    images[] {
      _key,
      alt,
      hidden,
      asset-> {
        url,
        originalFilename
      }
    },

    videos[] {
      _key,
      hidden,
      asset-> {
        url,
        originalFilename
      }
    }
  }
`)

const images = playground?.images?.filter((item) => !item.hidden) ?? []
const videos = playground?.videos?.filter((item) => !item.hidden) ?? []
---

<div class="playground-panel">
  {
    images.length ? (
      <div class="playground-masonry">
        {images.map((item) => (
          <figure class="playground-item">
            <img
              src={item.asset?.url}
              alt={item.alt || item.asset?.originalFilename || ''}
              loading="lazy"
            />
          </figure>
        ))}
      </div>
    ) : null
  }

  {
    videos.length ? (
      <div class="playground-masonry playground-videos">
        {videos.map((item) => (
          <figure class="playground-item">
            <video autoplay muted loop playsinline preload="metadata">
              <source src={item.asset?.url} />
            </video>
          </figure>
        ))}
      </div>
    ) : null
  }
</div>

<style>
  .playground-panel {
    min-height: 100%;
    background: #000;
    color: #fff;
  }

  .playground-masonry {
    columns: 4;
    column-gap: 8px;

    padding: 120px 40px 40px;
  }

  .playground-videos {
    padding-top: 0;
  }

  .playground-item {
    break-inside: avoid;
    margin: 0 0 8px;
  }

  .playground-item img,
  .playground-item video {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 900px) {
    .playground-masonry {
      columns: 2;
    }
  }

  @media (max-width: 700px) {
  .playground-masonry {
    columns: 3;
    column-gap: 4px;

    padding: 100px 4px 0;
  }

  .playground-videos {
    padding-top: 0;
  }

  .playground-item {
    margin-bottom: 4px;
  }
}
</style>
